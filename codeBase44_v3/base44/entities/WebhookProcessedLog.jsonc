{
  "name": "WebhookProcessedLog",
  "type": "object",
  "description": "Log webhook Stripe idempotent. D-097 r\u00e8gle 7.",
  "properties": {
    "stripeEventId": {
      "type": "string",
      "description": "evt_* Stripe \u2014 cl\u00e9 d'idempotency."
    },
    "eventType": {
      "type": "string",
      "description": "payment_intent.succeeded, account.updated, etc."
    },
    "receivedAt": {
      "type": "string",
      "description": "Timestamp r\u00e9ception."
    },
    "processingStatus": {
      "type": "string",
      "description": "IN_PROGRESS, COMPLETED."
    },
    "completedAt": {
      "type": "string",
      "description": "Timestamp compl\u00e9tion."
    },
    "action": {
      "type": "string",
      "description": "Action prise par le dispatcher."
    },
    "createdAt": {
      "type": "string",
      "description": "Timestamp ISO 8601."
    }
  },
  "required": [
    "stripeEventId",
    "eventType"
  ]
}