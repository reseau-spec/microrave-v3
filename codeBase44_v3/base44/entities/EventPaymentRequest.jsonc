{
  "name": "EventPaymentRequest",
  "type": "object",
  "description": "PaymentIntent Stripe associ\u00e9 \u00e0 un Engagement.",
  "properties": {
    "systemId": {
      "type": "string",
      "description": "IDFactory."
    },
    "engagementId": {
      "type": "string",
      "description": "ENG-*."
    },
    "stripePaymentIntentId": {
      "type": "string",
      "description": "pi_* Stripe."
    },
    "amountCents": {
      "type": "integer",
      "description": "Montant en cents."
    },
    "phase": {
      "type": "string",
      "description": "deposit ou balance."
    },
    "status": {
      "type": "string",
      "description": "\u00c9tat de la demande de paiement. pending = Checkout Session cr\u00e9\u00e9e en attente de paiement. succeeded = paiement encaiss\u00e9 (\u00e9crit par stripeWebhookHandler v4). failed = paiement \u00e9chou\u00e9 ou expir\u00e9. completed = legacy v3 (\u00e9quivaut \u00e0 succeeded)."
    },
    "createdAt": {
      "type": "string",
      "description": "Timestamp ISO 8601."
    },
    "organizerUserId": {
      "type": "string",
      "description": "USR-* de l'organisateur payeur."
    },
    "currency": {
      "type": "string",
      "description": "Code devise ISO. 'cad' par d\u00e9faut."
    },
    "stripeCheckoutSessionId": {
      "type": "string",
      "description": "ID Stripe Checkout Session (cs_*). Null si PaymentIntent direct."
    },
    "stripeCheckoutUrl": {
      "type": "string",
      "description": "URL de la Checkout Session h\u00e9berg\u00e9e par Stripe. Valide 24h."
    },
    "stripeClientSecret": {
      "type": "string",
      "description": "Client secret PaymentIntent pour montage Stripe.js c\u00f4t\u00e9 client. Null si Checkout Session."
    },
    "stripePublishableKey": {
      "type": "string",
      "description": "Cl\u00e9 publique Stripe pour Stripe.js. Null si Checkout Session."
    },
    "updatedAt": {
      "type": "string",
      "description": "Timestamp ISO 8601 de la derni\u00e8re mutation m\u00e9tier sur l'EPR (transition de statut typiquement). Distinct du champ Base44 updated_date (technique). \u00c9crit par stripeWebhookHandler v4 lors du passage en succeeded."
    }
  },
  "required": [
    "engagementId",
    "amountCents"
  ]
}