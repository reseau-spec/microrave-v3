{
  "name": "LedgerRecord",
  "type": "object",
  "description": "\u00c9criture comptable append-only en double-entr\u00e9e. LOI LEDGER-01/02. D-038/D-060. Chaque record est UNE LIGNE d'une transaction \u2014 les lignes sont li\u00e9es par transactionGroupId. NOTE : le champ type a \u00e9t\u00e9 supprim\u00e9 (doublon de financialStatement). Utiliser financialStatement pour classifier BILAN/RESULTAT/FLUX/MEMO.",
  "properties": {
    "systemId": {
      "type": "string",
      "description": "IDFactory LDG-*."
    },
    "transactionGroupId": {
      "type": "string",
      "description": "IDFactory TXG-*. Lie toutes les lignes DR+CR d'une m\u00eame transaction. INVARIANT : sum(DEBIT) = sum(CREDIT) pour chaque TXG-*."
    },
    "transactionType": {
      "type": "string",
      "description": "Type m\u00e9tier : encaissement_depot, encaissement_solde, payout_executed, reconnaissance_revenu, remise_tps, remise_tvq, refund, reversal, encaissement_saas, encaissement_billet, encaissement_commandite, ajustement_arrondi, ecart_processeur, amendment_delta, chargeback, retroactive_pierre_de_rosette."
    },
    "lineIndex": {
      "type": "integer",
      "description": "Index de la ligne dans le groupe (0, 1, 2...). Pour ordonner les lignes d'un m\u00eame TXG-*."
    },
    "engagementId": {
      "type": "string",
      "description": "ENG-*. Null si non li\u00e9 \u00e0 un Engagement (ex: encaissement SaaS)."
    },
    "eventId": {
      "type": "string",
      "description": "EVT-*. Null si non li\u00e9 \u00e0 un Event."
    },
    "skuCode": {
      "type": "string",
      "description": "Moteur \u00e9conomique : SKU-COURTAGE, SKU-SAAS, SKU-BILLETTERIE, SKU-COMMANDITES, SKU-INTERNE."
    },
    "subSkuCode": {
      "type": "string",
      "description": "Sous-code optionnel : SUB-COURT-DJ, SUB-SAAS-BASE-MENSUEL, etc."
    },
    "account": {
      "type": "string",
      "description": "Code comptable LedgerCodeMap V3 (D-060). Ex: 4310, 5200, 7110."
    },
    "direction": {
      "type": "string",
      "description": "DEBIT ou CREDIT."
    },
    "amountCents": {
      "type": "integer",
      "description": "Montant en cents entiers (D-064). Jamais float. Toujours >= 0."
    },
    "currency": {
      "type": "string",
      "description": "Code devise ISO. 'cad' par d\u00e9faut."
    },
    "talentUserId": {
      "type": "string",
      "description": "USR-* du talent si applicable."
    },
    "stripeTransferId": {
      "type": "string",
      "description": "ID Transfer Stripe si applicable."
    },
    "executedAt": {
      "type": "string",
      "description": "Timestamp ex\u00e9cution si applicable."
    },
    "note": {
      "type": "string",
      "description": "Note libre humainement lisible."
    },
    "metadata": {
      "type": "string",
      "description": "JSON s\u00e9rialis\u00e9 \u2014 donn\u00e9es contextuelles additionnelles."
    },
    "createdAt": {
      "type": "string",
      "description": "Timestamp ISO 8601. IMMUABLE apr\u00e8s cr\u00e9ation."
    },
    "reconciliationKey": {
      "type": "string",
      "description": "Cl\u00e9 de r\u00e9conciliation universelle (D-060-C). Format pr\u00e9fix\u00e9 : stripe:tr_xxx, journal:JNL-xxx, bank:xxx, reversal:TXG-xxx, legacy:xxx. Obligatoire sur toute \u00e9criture \u2014 permet l'audit sans parser metadata."
    },
    "financialStatement": {
      "type": "string",
      "enum": [
        "BILAN",
        "RESULTAT",
        "FLUX",
        "MEMO"
      ],
      "description": "\u00c9tat financier cible. BILAN = bilan (actif/passif). RESULTAT = compte de r\u00e9sultat (P&L). FLUX = \u00e9tat des flux de tr\u00e9sorerie. MEMO = \u00e9criture m\u00e9mo/statistique hors \u00e9tats. Obligatoire sur toute nouvelle \u00e9criture."
    },
    "flowCode": {
      "type": "string",
      "description": "Code flux de tr\u00e9sorerie (LedgerCodeMap type=FLUX). Ex: ENC-DEPOT, DEC-PAYOUT, INT-CAPTURE. Null si financialStatement != FLUX. R\u00e9f\u00e9rence le plan des flux du LedgerCodeMap V4."
    },
    "economicEvent": {
      "type": "string",
      "enum": [
        "placement_engagement",
        "encaissement_depot",
        "encaissement_balance",
        "reconnaissance_revenu",
        "payout_talent",
        "remboursement",
        "absorption_fiscale",
        "capture_interne",
        "regularisation",
        "backfill"
      ],
      "description": "\u00c9v\u00e9nement \u00e9conomique d\u00e9clencheur. Permet de reconstruire le journal par \u00e9v\u00e9nement ind\u00e9pendamment du compte."
    }
  },
  "required": [
    "amountCents",
    "direction",
    "account"
  ]
}