{
  "name": "Engagement",
  "type": "object",
  "description": "Contrat talent \u2194 organisateur. D-016/D-019-A. Lexique V3 souverain.",
  "properties": {
    "systemId": {
      "type": "string",
      "description": "IDFactory ENG-*."
    },
    "eventId": {
      "type": "string",
      "description": "EVT-* de l'\u00e9v\u00e9nement."
    },
    "talentUserId": {
      "type": "string",
      "description": "USR-* du talent."
    },
    "organizerUserId": {
      "type": "string",
      "description": "USR-* de l'organisateur."
    },
    "roleMetier": {
      "type": "string",
      "description": "DJ, photographe, MC, technicien, etc."
    },
    "cachetSigneCents": {
      "type": "integer",
      "description": "Cachet brut sign\u00e9 en cents."
    },
    "status": {
      "type": "string",
      "description": "\u00c9tat machine d'\u00e9tat V3 (47 transitions)."
    },
    "tauxPpm": {
      "type": "integer",
      "description": "Taux commission PPM effectif."
    },
    "prixVenduClientCents": {
      "type": "integer",
      "description": "Prix total pay\u00e9 par le client en cents."
    },
    "depositCents": {
      "type": "integer",
      "description": "Acompte en cents."
    },
    "balanceCents": {
      "type": "integer",
      "description": "Solde restant en cents."
    },
    "commissionMrCents": {
      "type": "integer",
      "description": "Commission Micro Rave en cents. = floor(cachetSigneCents x tauxPpm / 1000000). Gravee a la creation. Source : D-038."
    },
    "talentNetCents": {
      "type": "integer",
      "description": "Net talent apres commission en cents. = cachetSigneCents moins commissionMrCents."
    },
    "tpsCents": {
      "type": "integer",
      "description": "TPS per\u00e7ue en cents."
    },
    "tvqCents": {
      "type": "integer",
      "description": "TVQ per\u00e7ue en cents."
    },
    "currency": {
      "type": "string",
      "description": "cad."
    },
    "confirmedAt": {
      "type": "string",
      "description": "Timestamp confirmation."
    },
    "completedAt": {
      "type": "string",
      "description": "Timestamp compl\u00e9tion."
    },
    "cancelledAt": {
      "type": "string",
      "description": "Timestamp annulation."
    },
    "createdAt": {
      "type": "string",
      "description": "Timestamp ISO 8601."
    },
    "updatedAt": {
      "type": "string",
      "description": "Timestamp ISO 8601 de la derni\u00e8re mutation. Mis \u00e0 jour par toutes les fonctions qui modifient l'engagement (createEngagement, initiateDepositPayment, stripeWebhookHandler, transitionEngagement)."
    },
    "depositSecuredAt": {
      "type": "string",
      "description": "Timestamp de la transition deposit_pending \u2192 deposit_secured. \u00c9crit par stripeWebhookHandler et transitionEngagement quand le webhook checkout.session.completed ou payment_intent.succeeded confirme l'encaissement du d\u00e9p\u00f4t."
    },
    "settledAt": {
      "type": "string",
      "description": "Timestamp de la transition payable \u2192 settled. \u00c9crit par stripeWebhookHandler quand le webhook confirme l'encaissement du solde (phase=balance)."
    },
    "archivedAt": {
      "type": "string",
      "description": "Timestamp de la transition settled \u2192 archived. \u00c9crit par transitionEngagement. L'engagement entre en \u00e9tat WORM apr\u00e8s archivage."
    },
    "refundedAt": {
      "type": "string",
      "description": "Timestamp de la transition no_show \u2192 refunded. \u00c9crit par transitionEngagement quand le remboursement est ex\u00e9cut\u00e9."
    },
    "stripeDepositIntentId": {
      "type": "string",
      "description": "pi_* Stripe \u2014 PaymentIntent du d\u00e9p\u00f4t encaiss\u00e9. \u00c9crit par stripeWebhookHandler lors de la transition deposit_pending \u2192 deposit_secured. Permet de relier l'engagement \u00e0 la transaction Stripe sans passer par EventPaymentRequest. Source : D-097, OS V15."
    },
    "description": {
      "type": "string",
      "description": "Description de l'engagement \u2014 contexte, attentes, notes pour le talent. Optionnel."
    }
  },
  "required": [
    "eventId",
    "talentUserId",
    "organizerUserId"
  ]
}