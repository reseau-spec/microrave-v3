{
  "name": "Engagement",
  "type": "object",
  "description": "Contrat talent \u2194 organisateur. D-016/D-019-A. Lexique V3 souverain.",
  "properties": {
    "systemId": {
      "type": "string",
      "description": "IDFactory ENG-*."
    },
    "eventId": {
      "type": "string",
      "description": "EVT-* de l'\u00e9v\u00e9nement."
    },
    "talentUserId": {
      "type": "string",
      "description": "USR-* du talent."
    },
    "organizerUserId": {
      "type": "string",
      "description": "USR-* de l'organisateur."
    },
    "roleMetier": {
      "type": "string",
      "description": "DJ, photographe, MC, technicien, etc."
    },
    "cachetSigneCents": {
      "type": "integer",
      "description": "Cachet brut sign\u00e9 en cents."
    },
    "status": {
      "type": "string",
      "description": "\u00c9tat machine d'\u00e9tat V3 (47 transitions)."
    },
    "tauxPpm": {
      "type": "integer",
      "description": "Taux commission PPM effectif."
    },
    "prixVenduClientCents": {
      "type": "integer",
      "description": "Prix total pay\u00e9 par le client en cents."
    },
    "depositCents": {
      "type": "integer",
      "description": "Acompte en cents."
    },
    "balanceCents": {
      "type": "integer",
      "description": "Solde restant en cents."
    },
    "commissionMrCents": {
      "type": "integer",
      "description": "Commission Micro Rave en cents. = floor(cachetSigneCents x tauxPpm / 1000000). Gravee a la creation. Source : D-038."
    },
    "talentNetCents": {
      "type": "integer",
      "description": "Net talent apres commission en cents. = cachetSigneCents moins commissionMrCents."
    },
    "tpsCents": {
      "type": "integer",
      "description": "TPS per\u00e7ue en cents."
    },
    "tvqCents": {
      "type": "integer",
      "description": "TVQ per\u00e7ue en cents."
    },
    "currency": {
      "type": "string",
      "description": "cad."
    },
    "confirmedAt": {
      "type": "string",
      "description": "Timestamp confirmation."
    },
    "completedAt": {
      "type": "string",
      "description": "Timestamp compl\u00e9tion."
    },
    "cancelledAt": {
      "type": "string",
      "description": "Timestamp annulation."
    },
    "createdAt": {
      "type": "string",
      "description": "Timestamp ISO 8601."
    },
    "description": {
      "type": "string",
      "description": "Description de l'engagement \u2014 contexte, attentes, notes pour le talent. Optionnel."
    },
    "sealedAt": {
      "type": "string",
      "description": "Timestamp ISO scellement de l'\u00e9v\u00e9nement (\u00e9tat event_sealed). Immuable apr\u00e8s \u00e9criture."
    },
    "settledAt": {
      "type": "string",
      "description": "Timestamp ISO r\u00e8glement final (\u00e9tat settled). \u00c9crit par executePayoutTransfer."
    },
    "depositSecuredAt": {
      "type": "string",
      "description": "Timestamp ISO confirmation d\u00e9p\u00f4t Stripe (\u00e9tat deposit_secured). \u00c9crit par webhook."
    },
    "archivedAt": {
      "type": "string",
      "description": "Timestamp ISO archivage engagement (\u00e9tat archived). \u00c9crit par recognizeRevenue."
    },
    "stripeDepositIntentId": {
      "type": "string",
      "description": "pi_* Stripe du PaymentIntent de d\u00e9p\u00f4t encaiss\u00e9. \u00c9crit par stripeWebhookHandler v4 lors de la transition deposit_pending \u2192 deposit_secured. Permet de retracer le paiement Stripe associ\u00e9 \u00e0 l'engagement."
    },
    "stripeBalanceIntentId": {
      "type": "string",
      "description": "pi_* Stripe du PaymentIntent de balance encaiss\u00e9. \u00c9crit par stripeWebhookHandler v4 lors de l'encaissement de la balance. Pendant de stripeDepositIntentId pour la phase balance."
    },
    "updatedAt": {
      "type": "string",
      "description": "Timestamp ISO 8601 de la derni\u00e8re mutation m\u00e9tier sur l'engagement (transition d'\u00e9tat, encaissement, scellement, etc.). Distinct du champ Base44 updated_date (technique). \u00c9crit par toute fonction qui mute l'engagement."
    }
  },
  "required": [
    "eventId",
    "talentUserId",
    "organizerUserId"
  ]
}