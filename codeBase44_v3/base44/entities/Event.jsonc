{
  "name": "Event",
  "type": "object",
  "description": "\u00c9v\u00e9nement Micro Rave V3. D-016. Lexique V3 souverain.",
  "properties": {
    "systemId": {
      "type": "string",
      "description": "IDFactory EVT-*."
    },
    "organizerUserId": {
      "type": "string",
      "description": "USR-* de l'organisateur."
    },
    "name": {
      "type": "string",
      "description": "Nom de l'\u00e9v\u00e9nement."
    },
    "venue": {
      "type": "string",
      "description": "Lieu de l'\u00e9v\u00e9nement."
    },
    "scheduledStartAt": {
      "type": "string",
      "description": "Date/heure pr\u00e9vue ISO 8601."
    },
    "status": {
      "type": "string",
      "description": "draft, published, cancelled, completed."
    },
    "createdAt": {
      "type": "string",
      "description": "Timestamp ISO 8601."
    },
    "checkpointId": {
      "type": "string",
      "description": "CKP-* du Checkpoint associ\u00e9 \u00e0 cet \u00e9v\u00e9nement. Source de geoLat/geoLng/radiusKm pour la validation GPS de pr\u00e9sence (D-075)."
    }
  },
  "required": [
    "systemId",
    "organizerUserId",
    "name"
  ]
}