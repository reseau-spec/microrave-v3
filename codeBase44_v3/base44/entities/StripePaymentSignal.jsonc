{
  "name": "StripePaymentSignal",
  "type": "object",
  "description": "Signal paiement Stripe pour consommation par SignalConsumerService.",
  "properties": {
    "engagementId": {
      "type": "string",
      "description": "ENG-*."
    },
    "stripePaymentIntentId": {
      "type": "string",
      "description": "pi_* Stripe."
    },
    "stripeEventType": {
      "type": "string",
      "description": "payment_intent.succeeded, payment_intent.payment_failed."
    },
    "amountReceivedCents": {
      "type": "integer",
      "description": "Montant re\u00e7u en cents."
    },
    "currency": {
      "type": "string",
      "description": "cad."
    },
    "phase": {
      "type": "string",
      "description": "deposit ou balance."
    },
    "receivedAt": {
      "type": "string",
      "description": "Timestamp r\u00e9ception."
    },
    "processed": {
      "type": "boolean",
      "description": "false \u00e0 la cr\u00e9ation, true apr\u00e8s consommation."
    },
    "stripeFailureCode": {
      "type": "string",
      "description": "Code erreur Stripe si \u00e9chec."
    },
    "createdAt": {
      "type": "string",
      "description": "Timestamp ISO 8601."
    }
  },
  "required": [
    "engagementId",
    "stripeEventType",
    "amountReceivedCents"
  ]
}