{
  "name": "LineupPlacement",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "description": "Relation vers Session. Cl\u00e9 de jointure principale."
    },
    "eventId": {
      "type": "string",
      "description": "Relation vers Event. D\u00e9normalis\u00e9 pour requ\u00eates directes par event."
    },
    "userId": {
      "type": "string",
      "description": "Talent plac\u00e9 dans ce cr\u00e9neau."
    },
    "roleId": {
      "type": "string",
      "description": "systemId du r\u00f4le (RoleHierarchy) pour ce placement."
    },
    "slotId": {
      "type": "string",
      "description": "Identifiant stable du slot dans la session (SL-{sessionId}-{index})."
    },
    "sceneId": {
      "type": "string",
      "description": "Identifiant de la sc\u00e8ne physique (optionnel \u2014 multi-sc\u00e8nes)."
    },
    "assignedPrice": {
      "type": "number",
      "default": 0,
      "description": "Montant contract\u00e9 en CAD pour cette prestation. SOURCE DE V\u00c9RIT\u00c9 pour generatePayoutSplits."
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de confirmation du placement par l'organisateur."
    },
    "confirmedByUserId": {
      "type": "string",
      "description": "userId de l'organisateur qui a confirm\u00e9 ce placement."
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "cancelled",
        "no_show"
      ],
      "default": "confirmed",
      "description": "confirmed = actif pour payout, cancelled = retir\u00e9, no_show = talent absent (remboursement)."
    },
    "styleSystemIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Styles jou\u00e9s par le talent pour ce placement (snapshot au moment de la confirmation)."
    },
    "plageLabel": {
      "type": "string",
      "description": "Label lisible du cr\u00e9neau horaire (ex: '22h00 - 00h00'). D\u00e9normalis\u00e9 depuis le Programme."
    },
    "plageStartAt": {
      "type": "string",
      "format": "date-time",
      "description": "Heure de d\u00e9but du cr\u00e9neau."
    },
    "plageEndAt": {
      "type": "string",
      "format": "date-time",
      "description": "Heure de fin du cr\u00e9neau."
    }
  },
  "required": [
    "sessionId",
    "eventId",
    "userId",
    "roleId",
    "assignedPrice"
  ]
}