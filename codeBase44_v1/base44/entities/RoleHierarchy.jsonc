{
  "name": "RoleHierarchy",
  "type": "object",
  "properties": {
    "systemId": {
      "type": "string",
      "description": "Identifiant stable (ex: RL-000001)"
    },
    "nameFr": {
      "type": "string",
      "description": "Nom en fran\u00e7ais"
    },
    "nameEn": {
      "type": "string",
      "description": "Nom en anglais"
    },
    "bioFr": {
      "type": "string",
      "description": "Description en fran\u00e7ais"
    },
    "level": {
      "type": "number",
      "description": "Niveau hi\u00e9rarchique (1/2/3)"
    },
    "parentSystemId": {
      "type": "string",
      "description": "systemId du parent"
    },
    "racineSystemId": {
      "type": "string",
      "description": "systemId de la racine"
    },
    "roleType": {
      "type": "string",
      "enum": [
        "talent",
        "support",
        "organizer",
        "partner",
        "governance"
      ],
      "default": "talent",
      "description": "Type de r\u00f4le. talent = artiste/cr\u00e9ateur, support = technique, organizer = planificateur, partner = sponsor/marque, governance = administration."
    },
    "contributesToCheckpointDomains": {
      "type": "boolean",
      "default": false,
      "description": "Si true, ce r\u00f4le influence Session.domainKeysSnapshot et donc CheckpointDomainStats. Mettre true pour les r\u00f4les qui impactent l'exp\u00e9rience du lieu (talent + certains support: traiteur, r\u00e9gisseur, s\u00e9curit\u00e9/safe team). Laisser false pour organizer/partner/gouvernance (planner, sponsor, admin), sauf exception explicite."
    },
    "roleTags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tags de sp\u00e9cialit\u00e9 m\u00e9tier (ex: tech, equipement, lights, sound, security, stage, booking, sponsor, planning). N'influence PAS directement CheckpointDomainStats."
    },
    "domainKey": {
      "type": "string",
      "enum": [
        "music",
        "humour",
        "photo",
        "video",
        "food",
        "art",
        "responsable"
      ],
      "description": "Domaine du r\u00f4le. OBLIGATOIRE pour level=1 (r\u00f4les racines). Les sous-r\u00f4les (level 2/3) h\u00e9ritent du domaine via racineSystemId. Valeurs strictes uniquement."
    },
    "color": {
      "type": "string",
      "description": "Couleur hex pour UI"
    },
    "slug": {
      "type": "string",
      "description": "Slug URL-friendly"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "R\u00f4le actif"
    },
    "isBase": {
      "type": "boolean",
      "default": false,
      "description": "R\u00f4le de base"
    },
    "medianRate": {
      "type": "number",
      "description": "Tarif m\u00e9dian (r\u00e9f\u00e9rence)"
    },
    "maxRate": {
      "type": "number",
      "description": "Tarif maximum"
    },
    "xpRequired": {
      "type": "number",
      "default": 0,
      "description": "XP requis pour d\u00e9bloquer"
    },
    "sotsGlobalScore": {
      "type": "number",
      "default": 0,
      "description": "Score SOTS agr\u00e9g\u00e9 all-time"
    },
    "sotsRecent30Score": {
      "type": "number",
      "default": 0,
      "description": "Score SOTS des 30 derniers jours"
    },
    "totalVotes": {
      "type": "number",
      "default": 0,
      "description": "Nombre total de votes SOTS"
    }
  },
  "required": [
    "systemId",
    "nameFr",
    "level"
  ]
}