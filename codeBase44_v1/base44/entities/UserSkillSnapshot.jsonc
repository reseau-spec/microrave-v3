{
  "name": "UserSkillSnapshot",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "ID utilisateur (unique)"
    },
    "sotsGlobalScore": {
      "type": "number",
      "default": 0,
      "description": "Score SOTS all-time"
    },
    "sotsRecent30Score": {
      "type": "number",
      "default": 0,
      "description": "Score SOTS 30 derniers jours"
    },
    "xpTotal": {
      "type": "number",
      "default": 0,
      "description": "XP total"
    },
    "vibeRating": {
      "type": "number",
      "default": 3.0,
      "description": "Rating calcul\u00e9 (0-5)"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Derni\u00e8re mise \u00e0 jour"
    }
  },
  "required": [
    "userId"
  ]
}