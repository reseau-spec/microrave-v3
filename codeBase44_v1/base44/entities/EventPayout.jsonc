{
  "name": "EventPayout",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Ref vers Event.id"
    },
    "totalGrossAmount": {
      "type": "number",
      "default": 0,
      "description": "Montant brut total \u00e0 distribuer (priceTotal ou budget)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "disputed"
      ],
      "default": "pending",
      "description": "\u00c9tat du payout : pending \u2192 processing (splits g\u00e9n\u00e9r\u00e9s) \u2192 completed"
    },
    "triggerDate": {
      "type": "string",
      "format": "date-time",
      "description": "Date \u00e0 partir de laquelle le cron peut d\u00e9clencher les splits (+24h apr\u00e8s completedAt)"
    },
    "errorNote": {
      "type": "string",
      "description": "Note d'erreur si disputed"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "eventId"
  ]
}