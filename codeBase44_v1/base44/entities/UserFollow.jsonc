{
  "name": "UserFollow",
  "type": "object",
  "properties": {
    "followerUserId": {
      "type": "string",
      "description": "Utilisateur qui suit"
    },
    "followingUserId": {
      "type": "string",
      "description": "Utilisateur suivi"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "accepted",
        "blocked"
      ],
      "default": "requested",
      "description": "Statut de la relation"
    }
  },
  "required": [
    "followerUserId",
    "followingUserId"
  ]
}