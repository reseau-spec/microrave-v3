{
  "name": "PriceProposal",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Relation vers Event.id"
    },
    "sessionId": {
      "type": "string",
      "description": "Relation vers Session.id (session de type event)"
    },
    "slotId": {
      "type": "string",
      "description": "slotId du slot dans session.slots \u2014 identifie le r\u00f4le n\u00e9goci\u00e9"
    },
    "organizerUserId": {
      "type": "string",
      "description": "userId de l'organisateur qui initie la proposition"
    },
    "talentUserId": {
      "type": "string",
      "description": "userId du talent qui re\u00e7oit la proposition"
    },
    "targetPlageIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Liste des plageId concern\u00e9s par cette proposition. Utilis\u00e9 pour la contrainte anti-doublon (1 event par plage)."
    },
    "targetSceneId": {
      "type": "string",
      "description": "sceneId cible sur le plateau \u2014 peut \u00eatre null si non encore d\u00e9termin\u00e9"
    },
    "calculatedPrice": {
      "type": "number",
      "description": "Prix calcul\u00e9 par assignLineupSlot v5 avec les 8 primes. Source de v\u00e9rit\u00e9 march\u00e9. Jamais modifi\u00e9 apr\u00e8s cr\u00e9ation."
    },
    "currentOfferPrice": {
      "type": "number",
      "description": "Offre courante de l'organisateur (ou contre-offre talent si proposedBy=talent dans le dernier round). Correspond \u00e0 rounds[last].price."
    },
    "isGratuit": {
      "type": "boolean",
      "default": false,
      "description": "true si l'offre courante est \u00e0 0$ (b\u00e9n\u00e9volat). Mis \u00e0 jour \u00e0 chaque round."
    },
    "finalPrice": {
      "type": "number",
      "description": "Prix contract\u00e9 final \u2014 \u00e9crit seulement quand finalStatus=accepted. Utilis\u00e9 par generatePayoutSplits."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_talent",
        "pending_organizer",
        "accepted",
        "rejected",
        "withdrawn",
        "expired"
      ],
      "default": "pending_talent",
      "description": "\u00c9tat courant de la n\u00e9gociation. pending_talent=proposition envoy\u00e9e, pending_organizer=talent a contre-propos\u00e9, accepted=assignLineupSlot d\u00e9clench\u00e9, rejected=talent hors lineup, withdrawn=retir\u00e9e par l'organisateur, expired=72h sans r\u00e9ponse."
    },
    "finalStatus": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "withdrawn",
        "expired"
      ],
      "description": "R\u00e9sultat final \u2014 \u00e9crit seulement quand la n\u00e9gociation est termin\u00e9e"
    },
    "rounds": {
      "type": "array",
      "default": [],
      "description": "Historique complet des offres et contre-offres, dans l'ordre chronologique. Round 0 = proposition initiale organisateur.",
      "items": {
        "type": "object",
        "properties": {
          "roundIndex": {
            "type": "number",
            "description": "0 = offre initiale, 1 = 1\u00e8re r\u00e9ponse talent, 2 = r\u00e9ponse organisateur, \u2026"
          },
          "proposedBy": {
            "type": "string",
            "enum": [
              "organizer",
              "talent"
            ],
            "description": "Qui a fait cette offre"
          },
          "price": {
            "type": "number",
            "description": "Montant propos\u00e9 en CAD"
          },
          "isGratuit": {
            "type": "boolean",
            "default": false,
            "description": "true si prix = 0 (b\u00e9n\u00e9volat)"
          },
          "message": {
            "type": "string",
            "description": "Message optionnel accompagnant l'offre"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "rejected",
              "countered"
            ],
            "description": "R\u00e9sultat de ce round \u2014 pending tant que l'autre partie n'a pas r\u00e9pondu"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp de l'offre"
          },
          "respondedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp de la r\u00e9ponse (null si encore pending)"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Expiration de ce round (72h). Si d\u00e9pass\u00e9 sans r\u00e9ponse \u2192 status=expired."
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Cr\u00e9ation de la n\u00e9gociation (round 0)"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Derni\u00e8re mise \u00e0 jour (dernier round)"
    },
    "finalizedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de la r\u00e9solution finale (accepted/rejected/withdrawn)"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "Expiration globale de la n\u00e9gociation (72h depuis dernier round actif)"
    }
  },
  "required": [
    "eventId",
    "sessionId",
    "slotId",
    "organizerUserId",
    "talentUserId",
    "calculatedPrice",
    "currentOfferPrice"
  ]
}