{
  "name": "SellerTier",
  "type": "object",
  "description": "Table de classification des vendeurs Micro Rave. Un vendeur est l'organisateur d'un event dont le payeur est distinct (payerUserId != organizerId). Le tier d\u00e9termine le taux de commission sur la platform_fee MR. Source de v\u00e9rit\u00e9 unique pour les taux vendeur \u2014 jamais hardcod\u00e9 ailleurs.",
  "properties": {
    "userId": {
      "type": "string",
      "description": "UserId du vendeur. Un seul enregistrement actif par user."
    },
    "tier": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ],
      "description": "Tier vendeur. A=15% (top vendeurs), B=10% (standard), C=5% (d\u00e9butants). Assign\u00e9 manuellement par admin ou automatiquement selon seuils de volume."
    },
    "commissionRate": {
      "type": "number",
      "description": "Taux de commission fig\u00e9 selon le tier. A=0.15, B=0.10, C=0.05. Source de v\u00e9rit\u00e9 : ce champ, pas le tier. Permet des overrides individuels sans changer le tier."
    },
    "lifetimeSellerRevenue": {
      "type": "number",
      "default": 0,
      "description": "Revenu cumul\u00e9 g\u00e9n\u00e9r\u00e9 en tant que vendeur (somme des platform_fee des events o\u00f9 payerUserId != organizerId). Mis \u00e0 jour par generatePayoutSplits. Sert \u00e0 l'upgrade automatique de tier."
    },
    "lifetimeEventCount": {
      "type": "number",
      "default": 0,
      "description": "Nombre d'events vendus (payerUserId distinct). Mis \u00e0 jour par generatePayoutSplits."
    },
    "tierUpgradedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Date du dernier changement de tier."
    },
    "notes": {
      "type": "string",
      "description": "Notes admin (ex: 'Upgrade manuel \u2014 partenariat r\u00e9seau Montr\u00e9al')."
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "False = vendeur d\u00e9sactiv\u00e9 (commission = 0). Permet de suspendre sans supprimer."
    }
  },
  "required": [
    "userId",
    "tier",
    "commissionRate"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}