{
  "name": "UserDomainStats",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "ID de l'utilisateur"
    },
    "domainKey": {
      "type": "string",
      "enum": [
        "music",
        "humour",
        "photo",
        "video",
        "food",
        "art",
        "responsable"
      ],
      "description": "Domaine"
    },
    "sessionsCount": {
      "type": "number",
      "default": 0,
      "description": "Nombre de sessions compl\u00e9t\u00e9es"
    },
    "sotsSubmittedCount": {
      "type": "number",
      "default": 0,
      "description": "Nombre de SOTS soumis"
    },
    "avgSotsScore": {
      "type": "number",
      "default": 0,
      "description": "Score SOTS moyen (1-5)"
    },
    "xpDomain": {
      "type": "number",
      "default": 0,
      "description": "XP accumul\u00e9 dans ce domaine"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Points pour leaderboard"
    },
    "rank": {
      "type": "number",
      "description": "Rang dans le leaderboard du domaine"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Derni\u00e8re mise \u00e0 jour"
    }
  },
  "required": [
    "userId",
    "domainKey"
  ]
}