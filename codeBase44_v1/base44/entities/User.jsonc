{
  "name": "User",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Nom d'utilisateur unique"
    },
    "systemRoles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "user",
          "employee",
          "admin"
        ]
      },
      "default": [
        "user"
      ],
      "description": "R\u00f4les syst\u00e8me (non modifiable par utilisateur)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended"
      ],
      "default": "active",
      "description": "Statut du compte"
    },
    "referrerId": {
      "type": "string",
      "description": "ID de l'utilisateur qui a r\u00e9f\u00e9r\u00e9 (RSI dormant W1/W2)"
    },
    "referralCode": {
      "type": "string",
      "description": "Code de parrainage unique pour ce user"
    },
    "originContext": {
      "type": "object",
      "description": "Context d'acquisition (source, campaign, landing, refCode, ts)",
      "additionalProperties": true
    },
    "lastLoginAt": {
      "type": "string",
      "format": "date-time",
      "description": "Derni\u00e8re connexion"
    },
    "lastSeenAt": {
      "type": "string",
      "format": "date-time",
      "description": "Derni\u00e8re activit\u00e9"
    }
  },
  "required": [
    "username"
  ]
}