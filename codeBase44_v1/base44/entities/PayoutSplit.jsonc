{
  "name": "PayoutSplit",
  "type": "object",
  "properties": {
    "payoutId": {
      "type": "string",
      "description": "Ref vers EventPayout.id"
    },
    "eventId": {
      "type": "string",
      "description": "Ref vers Event.id (d\u00e9normalis\u00e9)"
    },
    "roleType": {
      "type": "string",
      "enum": [
        "platform_fee",
        "seller_commission",
        "talent_dj",
        "talent_video",
        "talent_humour",
        "platform_production",
        "talent_payout",
        "talent_noshow_refund"
      ],
      "description": "Type de b\u00e9n\u00e9ficiaire. talent_payout et talent_noshow_refund ajout\u00e9s pour generatePayoutSplits v4+"
    },
    "calculationType": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed_amount",
        "split_equal",
        "remainder",
        "contract_amount",
        "proportional_deposit",
        "percentage_post",
        "percentage_legacy",
        "refund"
      ],
      "description": "M\u00e9thode de calcul. contract_amount/proportional_deposit/percentage_post/refund ajout\u00e9s pour v4+"
    },
    "basisAmount": {
      "type": "number",
      "default": 0,
      "description": "Montant de base utilis\u00e9 pour le calcul"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Montant final attribu\u00e9 (CAD)"
    },
    "currency": {
      "type": "string",
      "default": "CAD"
    },
    "recipientUserId": {
      "type": "string",
      "description": "UserId du talent (null pour platform_fee, seller_commission, platform_production, noshow_refund)"
    },
    "effectiveCommissionRate": {
      "type": "number",
      "description": "Taux effectif appliqu\u00e9 \u00e0 ce split apr\u00e8s modulation SOTS. Ex: 0.108 = 10.8%. Null pour platform_fee et noshow_refund. Requis pour audit a posteriori \u2014 sans ce champ le calcul n'est pas reconstituable."
    },
    "note": {
      "type": "string",
      "description": "Description du split \u2014 inclut le d\u00e9tail du calcul (tier, SOTS, taux)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "disputed",
        "blocked"
      ],
      "default": "pending",
      "description": "pending = \u00e0 payer via Stripe Connect. blocked = invalid\u00e9 par resetAndRegeneratePayoutSplits (split fant\u00f4me)."
    },
    "stripeTransferId": {
      "type": "string",
      "description": "ID du transfer Stripe Connect une fois ex\u00e9cut\u00e9"
    },
    "paidAt": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "payoutId",
    "eventId",
    "roleType",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.recipientUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}