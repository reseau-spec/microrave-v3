{
  "name": "MembershipPlan",
  "type": "object",
  "properties": {
    "sku": {
      "type": "string",
      "description": "Identifiant stable du forfait. Convention: MR-PLAN-[TIER]-[YEAR][SEQ]. Ex: MR-PLAN-A-2024-01"
    },
    "tier": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ],
      "description": "Palier de commission. A=Freemium, B=Premium, C=Pro, D=Studio"
    },
    "nameFr": {
      "type": "string",
      "description": "Nom du forfait en fran\u00e7ais"
    },
    "nameEn": {
      "type": "string",
      "description": "Nom du forfait en anglais"
    },
    "descriptionFr": {
      "type": "string",
      "description": "Description du forfait en fran\u00e7ais"
    },
    "commissionRate": {
      "type": "number",
      "description": "Taux de commission de base (ex: 0.12 pour 12%). Source de v\u00e9rit\u00e9 pour les nouveaux abonnements."
    },
    "priceMonthly": {
      "type": "number",
      "default": 0,
      "description": "Prix mensuel en CAD (0 pour Freemium)"
    },
    "priceYearly": {
      "type": "number",
      "default": 0,
      "description": "Prix annuel en CAD (0 pour Freemium)"
    },
    "priceYearlySavings": {
      "type": "number",
      "default": 0,
      "description": "\u00c9conomie annuelle vs mensuel (affichage)"
    },
    "currency": {
      "type": "string",
      "default": "CAD",
      "description": "Devise (CAD)"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Liste des fonctionnalit\u00e9s incluses (affichage)"
    },
    "activeFrom": {
      "type": "string",
      "format": "date-time",
      "description": "Date de disponibilit\u00e9 du forfait"
    },
    "activeTo": {
      "type": "string",
      "format": "date-time",
      "description": "Date de fin de disponibilit\u00e9. null = toujours actif. Remplir pour granp\u00e9riser."
    },
    "isLegacy": {
      "type": "boolean",
      "default": false,
      "description": "true si le forfait est granp\u00e9ris\u00e9 (plus disponible \u00e0 la vente). Les abonnements existants continuent."
    },
    "sortOrder": {
      "type": "number",
      "default": 0,
      "description": "Ordre d'affichage dans l'UI (0 = premier)"
    }
  },
  "required": [
    "sku",
    "tier",
    "nameFr",
    "commissionRate"
  ]
}