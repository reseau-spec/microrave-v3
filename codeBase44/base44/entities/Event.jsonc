{
  "name": "Event",
  "type": "object",
  "description": "\u00c9v\u00e9nement organis\u00e9 sur la plateforme Micro Rave V3. Contient les informations logistiques et financi\u00e8res de l'\u00e9v\u00e9nement. Source : OS V10 section 5.3.",
  "properties": {
    "organizer_id": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence vers l'organisateur (User.id)."
    },
    "title": {
      "type": "string",
      "description": "Titre de l'\u00e9v\u00e9nement."
    },
    "description": {
      "type": "string",
      "description": "Description d\u00e9taill\u00e9e de l'\u00e9v\u00e9nement."
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "CANCELLED",
        "COMPLETED"
      ],
      "default": "DRAFT",
      "description": "Statut de publication de l'\u00e9v\u00e9nement."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "MICRO_RAVE",
        "CONCERT",
        "WORKSHOP",
        "PRIVATE",
        "OTHER"
      ],
      "description": "Type d'\u00e9v\u00e9nement."
    },
    "venue_name": {
      "type": "string",
      "description": "Nom du lieu."
    },
    "venue_address": {
      "type": "string",
      "description": "Adresse compl\u00e8te du lieu."
    },
    "city": {
      "type": "string",
      "description": "Ville de l'\u00e9v\u00e9nement."
    },
    "province": {
      "type": "string",
      "description": "Province canadienne. Ex: QC, ON."
    },
    "starts_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date et heure de d\u00e9but de l'\u00e9v\u00e9nement."
    },
    "ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date et heure de fin de l'\u00e9v\u00e9nement."
    },
    "capacity": {
      "type": "integer",
      "description": "Capacit\u00e9 maximale d'accueil."
    },
    "ticket_price_cents": {
      "type": "integer",
      "description": "Prix du billet en cents CAD. Ex: 2500 = 25,00$."
    },
    "currency": {
      "type": "string",
      "default": "CAD",
      "description": "Devise de l'\u00e9v\u00e9nement."
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "description": "\u00c9v\u00e9nement priv\u00e9 (sur invitation uniquement)."
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date/heure de publication. Null si DRAFT."
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date/heure d'annulation. Null si non annul\u00e9."
    },
    "metadata": {
      "type": "object",
      "description": "Donn\u00e9es suppl\u00e9mentaires arbitraires (JSON)."
    }
  },
  "required": [
    "organizer_id",
    "title"
  ]
}