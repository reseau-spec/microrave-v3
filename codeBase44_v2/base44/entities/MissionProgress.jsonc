{
  "name": "MissionProgress",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "Utilisateur"
    },
    "missionId": {
      "type": "string",
      "description": "Ref vers Mission.id"
    },
    "missionKey": {
      "type": "string",
      "description": "Snapshot de Mission.missionKey (d\u00e9normalis\u00e9 pour requ\u00eates)"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "completed",
        "claimed"
      ],
      "default": "in_progress",
      "description": "\u00c9tat de la progression"
    },
    "progress": {
      "type": "object",
      "description": "Compteurs par type: { session: 0, checkin: 0, sots_vote: 0 }",
      "additionalProperties": true
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de compl\u00e9tion (tous objectifs remplis)"
    },
    "claimedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de claim de la r\u00e9compense"
    }
  },
  "required": [
    "userId",
    "missionId",
    "missionKey"
  ]
}