{
  "name": "CheckpointRoleStats",
  "type": "object",
  "properties": {
    "checkpointSystemId": {
      "type": "string",
      "description": "ID du checkpoint"
    },
    "domainKey": {
      "type": "string",
      "enum": [
        "music",
        "humour",
        "photo",
        "video",
        "food",
        "art",
        "responsable"
      ],
      "description": "Domaine d'usage"
    },
    "roleSystemId": {
      "type": "string",
      "description": "ID du r\u00f4le"
    },
    "playsCount": {
      "type": "number",
      "default": 0,
      "description": "Nombre de sessions valid\u00e9es"
    },
    "uniqueTalentsCount": {
      "type": "number",
      "default": 0,
      "description": "Nombre de talents uniques (recalcul\u00e9 en batch)"
    },
    "sotsCount": {
      "type": "number",
      "default": 0,
      "description": "Nombre de votes SOTS"
    },
    "sotsSum": {
      "type": "number",
      "default": 0,
      "description": "Somme des scores SOTS"
    },
    "sotsAvg": {
      "type": "number",
      "default": 0,
      "description": "Score SOTS moyen"
    },
    "lastPlayedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Derni\u00e8re session valid\u00e9e"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Derni\u00e8re mise \u00e0 jour"
    }
  },
  "required": [
    "checkpointSystemId",
    "domainKey",
    "roleSystemId"
  ]
}