{
  "name": "CheckpointCheckin",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "Utilisateur qui a effectu\u00e9 le check-in"
    },
    "checkpointSystemId": {
      "type": "string",
      "description": "Checkpoint visit\u00e9"
    },
    "checkinAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp du check-in"
    },
    "geoLat": {
      "type": "number",
      "description": "Latitude GPS de l'utilisateur au moment du check-in"
    },
    "geoLng": {
      "type": "number",
      "description": "Longitude GPS de l'utilisateur au moment du check-in"
    },
    "distanceM": {
      "type": "number",
      "description": "Distance r\u00e9elle en m\u00e8tres entre l'utilisateur et le checkpoint"
    },
    "xpAwarded": {
      "type": "number",
      "default": 25,
      "description": "XP attribu\u00e9s pour ce check-in"
    }
  },
  "required": [
    "userId",
    "checkpointSystemId",
    "checkinAt"
  ]
}