{
  "name": "EventTicketConfig",
  "type": "object",
  "description": "Configuration billetterie d'un event. Cr\u00e9\u00e9e par l'organisateur. Contr\u00f4le si la billetterie est active, le prix, la capacit\u00e9, et les taux de distribution Pool C. Un seul EventTicketConfig par event. Fig\u00e9 apr\u00e8s le premier billet vendu (champs financiers).",
  "properties": {
    "eventId": {
      "type": "string",
      "description": "FK Event. Un seul EventTicketConfig par event."
    },
    "isActive": {
      "type": "boolean",
      "description": "La billetterie est-elle ouverte ? False = pas de vente de billets pour cet event."
    },
    "ticketPrice": {
      "type": "number",
      "description": "Prix net du billet en CAD. Ce que l'organisateur re\u00e7oit par billet. Fig\u00e9 apr\u00e8s le premier billet vendu."
    },
    "capacity": {
      "type": "integer",
      "description": "Nombre maximum de billets. Null = illimit\u00e9 (d\u00e9conseill\u00e9)."
    },
    "soldCount": {
      "type": "integer",
      "default": 0,
      "description": "Nombre de billets vendus (status=paid). Mis \u00e0 jour \u00e0 chaque vente."
    },
    "scannedCount": {
      "type": "integer",
      "default": 0,
      "description": "Nombre de billets scann\u00e9s \u00e0 l'entr\u00e9e. Source de v\u00e9rit\u00e9 pour la pr\u00e9sence audience."
    },
    "totalTicketRevenue": {
      "type": "number",
      "default": 0,
      "description": "Somme des ticketPrice de tous les billets vendus (net). Mis \u00e0 jour \u00e0 chaque vente. Source de v\u00e9rit\u00e9 pour Pool C."
    },
    "sellerTicketRate": {
      "type": "number",
      "default": 0.95,
      "description": "Part de la billetterie revenant au vendeur/organisateur. D\u00e9faut 0.95 (95%). Fig\u00e9 apr\u00e8s le premier billet vendu."
    },
    "mrTicketRate": {
      "type": "number",
      "default": 0.05,
      "description": "Part Micro Rave sur la billetterie. D\u00e9faut 0.05 (5%). = 1 - sellerTicketRate. Fig\u00e9 apr\u00e8s le premier billet vendu."
    },
    "isTransferable": {
      "type": "boolean",
      "default": false,
      "description": "Les billets de cet event sont-ils transf\u00e9rables entre users ?"
    },
    "salesOpenAt": {
      "type": "string",
      "format": "date-time",
      "description": "Ouverture des ventes. Null = d\u00e8s la publication de l'event."
    },
    "salesCloseAt": {
      "type": "string",
      "format": "date-time",
      "description": "Fermeture des ventes. Null = jusqu'au d\u00e9but de l'event."
    },
    "ticketFinancialsLockedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp du premier billet vendu. Apr\u00e8s ce point, ticketPrice, sellerTicketRate, mrTicketRate sont immuables."
    }
  },
  "required": [
    "eventId",
    "isActive",
    "ticketPrice"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.eventId": "{{user.events_as_organizer_ids}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.eventId": "{{user.events_as_organizer_ids}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}