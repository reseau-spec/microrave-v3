{
  "name": "EventPaymentLog",
  "type": "object",
  "description": "Registre immuable de chaque transaction Stripe re\u00e7ue. Une entr\u00e9e par PaymentIntent captur\u00e9. Source de v\u00e9rit\u00e9 pour : qui a pay\u00e9 quoi, sur quel PI, dans quel ordre. Utilis\u00e9 pour les remboursements ordonn\u00e9s (FIFO invers\u00e9) et la r\u00e9conciliation Stripe. Ne jamais modifier une entr\u00e9e existante.",
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Relation vers Event.id"
    },
    "paymentRequestId": {
      "type": "string",
      "description": "Relation vers EventPaymentRequest.id \u2014 demande source de cette transaction"
    },
    "stripePaymentIntentId": {
      "type": "string",
      "description": "PI Stripe exact (pi_...). Cl\u00e9 d'idempotence \u2014 un seul EventPaymentLog par PI."
    },
    "stripeChargeId": {
      "type": "string",
      "description": "Charge Stripe (ch_...) \u2014 requis pour \u00e9mettre un stripe.refunds.create. Extrait de pi.latest_charge."
    },
    "payerUserId": {
      "type": "string",
      "description": "userId r\u00e9solu depuis billing_details Stripe. Source de v\u00e9rit\u00e9 \u2014 peut diff\u00e9rer du payerUserId d\u00e9sign\u00e9 par l'organisateur si quelqu'un d'autre a pay\u00e9 physiquement."
    },
    "payerEmail": {
      "type": "string",
      "description": "Email billing_details Stripe. Source de v\u00e9rit\u00e9 pour remboursement et re\u00e7u fiscal."
    },
    "payerName": {
      "type": "string",
      "description": "Nom billing_details Stripe."
    },
    "paymentType": {
      "type": "string",
      "enum": [
        "deposit",
        "balance",
        "adjustment",
        "deposit_supplement"
      ],
      "description": "Type de transaction. D\u00e9termine quel pool rembourser en cas de no-show."
    },
    "requestedAmount": {
      "type": "number",
      "description": "Montant brut factur\u00e9 au payeur (avec frais Stripe)."
    },
    "stripeFeeAmount": {
      "type": "number",
      "description": "Frais Stripe estim\u00e9s sur cette transaction."
    },
    "netAmount": {
      "type": "number",
      "description": "Montant net re\u00e7u par Micro Rave (requestedAmount - stripeFeeAmount). Utilis\u00e9 pour les \u00e9tats financiers."
    },
    "sequenceNumber": {
      "type": "number",
      "description": "Ordre d'arriv\u00e9e des paiements pour cet event (1, 2, 3...). En cas de remboursement partiel, on rembourse en ordre inverse (dernier entr\u00e9 = premier rembours\u00e9). Garantit un remboursement d\u00e9terministe et auditable."
    },
    "status": {
      "type": "string",
      "enum": [
        "authorized",
        "captured",
        "refunded",
        "partially_refunded",
        "failed"
      ],
      "default": "authorized",
      "description": "authorized=PI cr\u00e9\u00e9, captured=argent re\u00e7u, refunded=int\u00e9gralement rembours\u00e9, partially_refunded=remboursement partiel."
    },
    "refundedAmount": {
      "type": "number",
      "default": 0,
      "description": "Cumul des remboursements \u00e9mis sur ce PI. refundableAmount = netAmount - refundedAmount."
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp exact de la capture Stripe. Immutable."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de cr\u00e9ation de l'entr\u00e9e. Immutable."
    }
  },
  "required": [
    "eventId",
    "stripePaymentIntentId",
    "paymentType",
    "sequenceNumber",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.payerUserId": "{{user.id}}"
        },
        {
          "data.eventId": "{{user.events_as_organizer_ids}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}