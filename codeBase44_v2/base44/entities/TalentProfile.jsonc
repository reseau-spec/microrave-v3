{
  "name": "TalentProfile",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "Relation vers User"
    },
    "displayName": {
      "type": "string",
      "description": "Nom d'affichage public"
    },
    "bio": {
      "type": "string",
      "description": "Biographie"
    },
    "referralCode": {
      "type": "string",
      "description": "Code de parrainage unique de ce talent"
    },
    "referrerId": {
      "type": "string",
      "description": "userId du talent qui a r\u00e9f\u00e9r\u00e9 cet utilisateur"
    },
    "referrerCode": {
      "type": "string",
      "description": "Code utilis\u00e9 lors de l'inscription (RSI tracking)"
    },
    "avatarUrl": {
      "type": "string",
      "description": "URL de l'avatar"
    },
    "primaryCheckpointId": {
      "type": "string",
      "description": "Checkpoint principal (quartier/ville)"
    },
    "activeDomains": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "music",
          "humour",
          "photo",
          "video",
          "food",
          "art",
          "responsable"
        ]
      },
      "default": [],
      "description": "Domaines actifs choisis par l'utilisateur"
    },
    "activeRoles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liste des systemId de r\u00f4les actifs (miroir public de UserPreferences)"
    },
    "activeStyles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liste des systemId de styles actifs"
    },
    "styleWeights": {
      "type": "object",
      "description": "Poids des styles actifs { styleSystemId: weight }",
      "additionalProperties": true
    },
    "activeCheckpoints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liste des systemId de checkpoints actifs"
    },
    "primaryStyleSystemIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Styles principaux habituels (pour calcul anti-bulle)"
    },
    "xpGlobal": {
      "type": "number",
      "default": 0,
      "description": "Points d'exp\u00e9rience totaux"
    },
    "cosmeticXp": {
      "type": "number",
      "default": 0,
      "description": "XP cosm\u00e9tique (gamification, pas pricing)"
    },
    "cosmeticBadges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Badges cosm\u00e9tiques (Explorer, Experimentalist, etc.)"
    },
    "sotsGlobalScore": {
      "type": "number",
      "default": 0,
      "description": "Score SOTS agr\u00e9g\u00e9 all-time (calcul\u00e9)"
    },
    "sotsRecent30Score": {
      "type": "number",
      "default": 0,
      "description": "Score SOTS des 30 derniers jours"
    },
    "trustScore": {
      "type": "number",
      "default": 0,
      "description": "Score de confiance pour commissions (W3+)"
    },
    "pricingBase": {
      "type": "object",
      "description": "Tarifs de base par r\u00f4le { DJ: 100, VJ: 120 }",
      "additionalProperties": true
    },
    "verifiedRevenueTotal": {
      "type": "number",
      "default": 0,
      "description": "Revenus certifi\u00e9s cumul\u00e9s (W3/W4)"
    },
    "badgeSlots": {
      "type": "object",
      "description": "Badges UI (W4)",
      "additionalProperties": true
    },
    "leagueSlots": {
      "type": "object",
      "description": "Ligues/Saison (W4)",
      "additionalProperties": true
    },
    "earnedRoles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "R\u00f4les gagn\u00e9s par usage r\u00e9el (ex: 'Vendeur', 'Organisateur') \u2014 jamais s\u00e9lectionnables manuellement"
    }
  },
  "required": [
    "userId",
    "displayName"
  ]
}