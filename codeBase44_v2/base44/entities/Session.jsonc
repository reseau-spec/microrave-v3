{
  "name": "Session",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Relation vers Event (null si QuickPlay)"
    },
    "hostUserId": {
      "type": "string",
      "description": "Arbitre technique / host"
    },
    "captainUserId": {
      "type": "string",
      "description": "Capitaine actuel (leader du lobby, premier entr\u00e9)"
    },
    "launchedByUserId": {
      "type": "string",
      "description": "UserId qui a lanc\u00e9 la session (audit)"
    },
    "launchRequestedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Date/heure du lancement manuel"
    },
    "checkpointSystemId": {
      "type": "string",
      "description": "Checkpoint (carte) s\u00e9lectionn\u00e9 par le capitaine"
    },
    "checkpointLockedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Moment o\u00f9 le checkpoint a \u00e9t\u00e9 verrouill\u00e9 (au start)"
    },
    "checkpointLockedByUserId": {
      "type": "string",
      "description": "UserId qui a verrouill\u00e9 le checkpoint (capitaine)"
    },
    "sessionType": {
      "type": "string",
      "enum": [
        "quickplay",
        "event_gig",
        "jam",
        "stream",
        "event"
      ],
      "default": "quickplay",
      "description": "Type de session"
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "queueing",
        "matched",
        "lobby",
        "ready",
        "in_progress",
        "completed",
        "aborted",
        "disputed",
        "sots_submitted",
        "archived"
      ],
      "default": "idle",
      "description": "\u00c9tat du lifecycle"
    },
    "minPlayers": {
      "type": "number",
      "default": 2,
      "description": "Nombre minimum de joueurs"
    },
    "maxPlayers": {
      "type": "number",
      "default": 6,
      "description": "Nombre maximum de joueurs"
    },
    "scheduledStartAt": {
      "type": "string",
      "format": "date-time",
      "description": "Heure pr\u00e9vue de d\u00e9marrage"
    },
    "actualStartAt": {
      "type": "string",
      "format": "date-time",
      "description": "Heure r\u00e9elle de d\u00e9marrage"
    },
    "actualEndAt": {
      "type": "string",
      "format": "date-time",
      "description": "Heure r\u00e9elle de fin"
    },
    "lobbyOpenedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Moment o\u00f9 le lobby s'est ouvert (minPlayers atteint)"
    },
    "lockedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Moment o\u00f9 la session a \u00e9t\u00e9 verrouill\u00e9e (plus de nouveaux joueurs)"
    },
    "startAt": {
      "type": "string",
      "format": "date-time",
      "description": "Moment du d\u00e9marrage effectif"
    },
    "moodFilterSnapshot": {
      "type": "object",
      "description": "Snapshot des pr\u00e9f\u00e9rences + ajustements \u00e9ph\u00e9m\u00e8res",
      "additionalProperties": true
    },
    "referrerId": {
      "type": "string",
      "description": "Copie de User.referrerId (RSI tracking)"
    },
    "originContext": {
      "type": "object",
      "description": "Context enrichi user + session",
      "additionalProperties": true
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "roleSystemId": {
            "type": "string"
          },
          "styleSystemId": {
            "type": "string"
          },
          "styleSystemIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "isNoShow": {
            "type": "boolean"
          },
          "sotsSubmitted": {
            "type": "boolean"
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          },
          "submittedBallot": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Liste des participants avec leur \u00e9tat"
    },
    "sotsSubmittedBy": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Liste des userId ayant soumis SOTS"
    },
    "slots": {
      "type": "array",
      "description": "Slots multi-r\u00f4le pour sessions de type event UNIQUEMENT. Optionnel \u2014 jamais pr\u00e9sent sur QuickPlay.",
      "items": {
        "type": "object",
        "properties": {
          "slotId": {
            "type": "string",
            "description": "Identifiant stable unique dans la session (SL-{sessionId}-{index})"
          },
          "roleSystemId": {
            "type": "string",
            "description": "R\u00f4le requis pour ce slot"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "pending",
              "confirmed"
            ],
            "default": "open",
            "description": "\u00c9tat du slot"
          },
          "candidateUserId": {
            "type": "string",
            "description": "D\u00c9PR\u00c9CI\u00c9 \u2014 ne plus utiliser pour identifier le talent affich\u00e9. Valeur stale : premier talent confirm\u00e9 sur ce slot via confirmSlot, jamais mis \u00e0 jour si un autre talent est s\u00e9lectionn\u00e9 ensuite. Cause l'affichage du mauvais talent dans les sessions ant\u00e9rieures \u00e0 assignLineupSlot v6. SOURCE CORRECTE : LineupPlacement.userId (priorit\u00e9 1) ou Session.moodFilterSnapshot.lineupPlacements[key].userId (priorit\u00e9 2) ou Session.slots[].candidates[].userId (priorit\u00e9 3). Conserv\u00e9 en lecture seule pour r\u00e9trocompatibilit\u00e9 DB."
          },
          "candidateStyleSystemIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Styles du candidat"
          },
          "confirmedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date de confirmation (uniquement si confirmed)"
          },
          "confirmedBy": {
            "type": "string",
            "description": "UserId de l'organisateur qui a confirm\u00e9"
          }
        },
        "required": [
          "slotId",
          "roleSystemId",
          "status"
        ]
      }
    }
  },
  "required": [
    "sessionType",
    "status"
  ]
}