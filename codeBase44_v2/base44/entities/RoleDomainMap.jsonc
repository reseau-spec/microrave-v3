{
  "name": "RoleDomainMap",
  "type": "object",
  "description": "Mapping r\u00f4le \u2194 domaine. LEGACY \u2014 les r\u00f4les actifs utilisent directement RoleHierarchy.domainKey. Cette entit\u00e9 est conserv\u00e9e pour les r\u00f4les techniques (tech, equipement, producer) qui n'ont pas de domainKey dans RoleHierarchy. Ne plus \u00e9crire de nouveaux mappings ici \u2014 utiliser RoleHierarchy.domainKey directement.",
  "properties": {
    "roleSystemId": {
      "type": "string",
      "description": "ID du r\u00f4le (ex: RL-000001)"
    },
    "domainKey": {
      "type": "string",
      "description": "Cl\u00e9 de domaine. Lire depuis l'entit\u00e9 Domain pour la liste des domaines valides. Aucun enum \u2014 les domaines sont dynamiques."
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Mapping actif"
    }
  },
  "required": [
    "roleSystemId",
    "domainKey"
  ]
}