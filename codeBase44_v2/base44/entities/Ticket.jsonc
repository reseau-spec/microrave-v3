{
  "name": "Ticket",
  "type": "object",
  "description": "Billet unitaire vendu \u00e0 un membre de l'audience. Chaque Ticket correspond \u00e0 une transaction Stripe distincte \u2014 jamais regroup\u00e9 dans EventPaymentRequest. Source de v\u00e9rit\u00e9 pour Pool C (billetterie) dans generatePayoutSplits. Immuable apr\u00e8s \u00e9mission sauf pour refundStatus.",
  "properties": {
    "eventId": {
      "type": "string",
      "description": "FK Event. Un event peut avoir N Tickets de N acheteurs distincts."
    },
    "buyerUserId": {
      "type": "string",
      "description": "UserId de l'acheteur du billet. Peut diff\u00e9rer du titulaire final (cadeaux). Source de v\u00e9rit\u00e9 pour les remboursements Stripe."
    },
    "buyerEmail": {
      "type": "string",
      "description": "Email r\u00e9el de l'acheteur \u2014 captur\u00e9 depuis Stripe billing_details.email au paiement. Source de v\u00e9rit\u00e9, jamais depuis le profil user."
    },
    "buyerName": {
      "type": "string",
      "description": "Nom r\u00e9el \u2014 captur\u00e9 depuis Stripe billing_details.name au paiement."
    },
    "ticketPrice": {
      "type": "number",
      "description": "Prix net du billet (ce que l'event vendeur re\u00e7oit). Ex: 10.00$. Fig\u00e9 \u00e0 l'achat."
    },
    "grossAmount": {
      "type": "number",
      "description": "Montant brut pay\u00e9 par l'acheteur (ticketPrice + frais Stripe). Ex: 10.61$. Fig\u00e9 \u00e0 l'achat."
    },
    "stripeFeeAmount": {
      "type": "number",
      "description": "Frais Stripe inclus dans grossAmount. \u00c0 la charge de l'acheteur du billet."
    },
    "stripePaymentIntentId": {
      "type": "string",
      "description": "PI Stripe de cette transaction billet. Unique par Ticket. Source de v\u00e9rit\u00e9 pour remboursement."
    },
    "stripeChargeId": {
      "type": "string",
      "description": "Charge Stripe (ch_...) pour cr\u00e9ation de refunds. R\u00e9solu depuis PI au webhook payment_intent.succeeded."
    },
    "sequenceNumber": {
      "type": "integer",
      "description": "Ordre d'achat au sein de l'event (1, 2, 3...). Pour remboursements LIFO si annulation partielle."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "used",
        "refunded",
        "partially_refunded",
        "expired"
      ],
      "default": "pending",
      "description": "pending=PI cr\u00e9\u00e9, paid=captur\u00e9 Stripe, used=scanned \u00e0 l'entr\u00e9e, refunded=rembours\u00e9 int\u00e9gralement, partially_refunded=remboursement partiel."
    },
    "refundStatus": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "default": "none",
      "description": "\u00c9tat du remboursement. Mis \u00e0 jour par refundTicket."
    },
    "refundedAmount": {
      "type": "number",
      "default": 0,
      "description": "Montant d\u00e9j\u00e0 rembours\u00e9 sur ce billet. 0 au d\u00e9part. Max = grossAmount."
    },
    "refundableAmount": {
      "type": "number",
      "description": "grossAmount - refundedAmount. Source de v\u00e9rit\u00e9 pour les remboursements partiels."
    },
    "refundReason": {
      "type": "string",
      "enum": [
        "event_cancelled",
        "talent_noshow",
        "organizer_request",
        "buyer_request"
      ],
      "description": "Motif du remboursement. Obligatoire si refundStatus != none."
    },
    "noShowFraction": {
      "type": "number",
      "description": "Fraction du remboursement appliqu\u00e9e \u00e0 ce billet en cas de no-show partiel. Ex: 0.40 si 40% des talents absents. Calcul\u00e9 par generatePayoutSplits."
    },
    "qrCode": {
      "type": "string",
      "description": "Code QR unique pour scan \u00e0 l'entr\u00e9e. G\u00e9n\u00e9r\u00e9 \u00e0 l'\u00e9mission du billet. Format: UUID v4."
    },
    "scannedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp du scan \u00e0 l'entr\u00e9e. Null si non scann\u00e9. Preuve de livraison du service."
    },
    "scannedByUserId": {
      "type": "string",
      "description": "UserId de l'organisateur/staff qui a scann\u00e9 le billet."
    },
    "isTransferable": {
      "type": "boolean",
      "default": false,
      "description": "Le billet peut-il \u00eatre transf\u00e9r\u00e9 \u00e0 un autre user ? D\u00e9cid\u00e9 par l'organisateur \u00e0 la cr\u00e9ation de l'event."
    },
    "transferredFromTicketId": {
      "type": "string",
      "description": "Si transf\u00e9r\u00e9, ID du billet original."
    },
    "paidAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp exact du paiement confirm\u00e9 par Stripe. Immutable apr\u00e8s \u00e9criture."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Immutable apr\u00e8s cr\u00e9ation."
    }
  },
  "required": [
    "eventId",
    "ticketPrice",
    "status"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.buyerUserId": "{{user.id}}"
        },
        {
          "data.eventId": "{{user.events_as_organizer_ids}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}