{
  "name": "EventPaymentRequest",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Relation vers Event.id"
    },
    "organizerUserId": {
      "type": "string",
      "description": "userId de l'organisateur qui a cr\u00e9\u00e9 la demande"
    },
    "payerEmail": {
      "type": "string",
      "description": "Email du payeur (payeur sans compte)"
    },
    "payerUserId": {
      "type": "string",
      "description": "userId du payeur s'il a un compte (nullable)"
    },
    "requestedAmount": {
      "type": "number",
      "description": "Montant demand\u00e9 en dollars CAD (toujours 20% de event.budget)"
    },
    "messageToPayer": {
      "type": "string",
      "description": "Message personnalis\u00e9 de l'organisateur au payeur"
    },
    "secureToken": {
      "type": "string",
      "description": "UUID unique d'acc\u00e8s \u00e0 la page de paiement"
    },
    "requestStatus": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "viewed",
        "approved",
        "rejected",
        "expired"
      ],
      "default": "sent",
      "description": "draft=cr\u00e9\u00e9e, sent=email envoy\u00e9, viewed=page ouverte, approved=paiement confirm\u00e9, rejected=refus\u00e9, expired=d\u00e9lai d\u00e9pass\u00e9"
    },
    "stripePaymentIntentId": {
      "type": "string",
      "description": "Stripe PaymentIntent ID cr\u00e9\u00e9 lors du paiement"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'expiration du lien (72h apr\u00e8s cr\u00e9ation)"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de cr\u00e9ation"
    }
  },
  "required": [
    "eventId",
    "organizerUserId",
    "payerEmail",
    "requestedAmount",
    "secureToken"
  ]
}