{
  "name": "AdminCase",
  "type": "object",
  "properties": {
    "caseType": {
      "type": "string",
      "enum": [
        "dispute",
        "fraud_review",
        "manual_adjustment"
      ],
      "description": "Type de cas"
    },
    "relatedEventId": {
      "type": "string",
      "description": "Relation vers Event (optionnel)"
    },
    "relatedSessionId": {
      "type": "string",
      "description": "Relation vers Session (optionnel)"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "resolved",
        "rejected"
      ],
      "default": "open",
      "description": "Statut du cas"
    },
    "notesInternal": {
      "type": "string",
      "description": "Notes internes (admin uniquement)"
    }
  },
  "required": [
    "caseType"
  ]
}