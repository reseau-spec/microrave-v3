{
  "name": "CheckpointUserStats",
  "type": "object",
  "properties": {
    "checkpointSystemId": {
      "type": "string",
      "description": "ID du checkpoint"
    },
    "domainKey": {
      "type": "string",
      "enum": [
        "music",
        "humour",
        "photo",
        "video",
        "food",
        "art",
        "responsable"
      ],
      "description": "Domaine d'usage"
    },
    "userId": {
      "type": "string",
      "description": "ID de l'utilisateur"
    },
    "playsCount": {
      "type": "number",
      "default": 0,
      "description": "Nombre de sessions valid\u00e9es"
    },
    "sotsCountReceived": {
      "type": "number",
      "default": 0,
      "description": "Nombre de votes SOTS re\u00e7us"
    },
    "sotsSumReceived": {
      "type": "number",
      "default": 0,
      "description": "Somme des scores SOTS re\u00e7us"
    },
    "sotsAvgReceived": {
      "type": "number",
      "default": 0,
      "description": "Score SOTS moyen re\u00e7u"
    },
    "lastPlayedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Derni\u00e8re session valid\u00e9e"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Derni\u00e8re mise \u00e0 jour"
    }
  },
  "required": [
    "checkpointSystemId",
    "domainKey",
    "userId"
  ]
}