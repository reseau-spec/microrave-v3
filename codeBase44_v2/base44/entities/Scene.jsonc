{
  "name": "Scene",
  "type": "object",
  "properties": {
    "sceneKey": {
      "type": "string",
      "description": "Cl\u00e9 stable unique : {domainKey}_{sortedCheckpointIds[0..3] joints par '-'}"
    },
    "domainKey": {
      "type": "string",
      "enum": [
        "music",
        "humour",
        "photo",
        "video",
        "food",
        "art",
        "responsable"
      ],
      "description": "Domaine dominant de la sc\u00e8ne"
    },
    "sceneName": {
      "type": "string",
      "description": "Nom g\u00e9n\u00e9r\u00e9 : 'Sc\u00e8ne music \u2014 Nom du checkpoint seed'"
    },
    "centerLat": {
      "type": "number",
      "description": "Centro\u00efde latitude du cluster"
    },
    "centerLng": {
      "type": "number",
      "description": "Centro\u00efde longitude du cluster"
    },
    "checkpointSystemIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Tableau des systemId de checkpoints formant le cluster \u2014 tri\u00e9 alphab\u00e9tiquement"
    },
    "checkpointCount": {
      "type": "number",
      "default": 0,
      "description": "Nombre de checkpoints dans la sc\u00e8ne"
    },
    "sceneScore": {
      "type": "number",
      "default": 0,
      "description": "Score composite : checkpointCount\u00d720 + totalMomentum\u00d75"
    },
    "activeMomentCount": {
      "type": "number",
      "default": 0,
      "description": "Nombre de CulturalMoments actifs (rising/live/peak) li\u00e9s \u00e0 cette sc\u00e8ne"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "false si le cluster a perdu son momentum (aucun checkpoint actif)"
    },
    "lastComputedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Dernier calcul CRON"
    }
  },
  "required": [
    "sceneKey",
    "domainKey"
  ]
}