# ============================================================
# MICRO RAVE V3 — Variables d'environnement
# ============================================================
# IMPORTANT : Ce fichier est un EXEMPLE.
# Copier en .env et remplir les vraies valeurs.
# Ne JAMAIS committer .env dans GitHub.
# ============================================================

# ── ENVIRONNEMENT ────────────────────────────────────────────
NODE_ENV=development
# Valeurs possibles : development | staging | production

# ── STRIPE ──────────────────────────────────────────────────
# dev + staging → clés TEST uniquement (sk_test_...)
# production → clés LIVE (sk_live_...) — accès minimal
STRIPE_SECRET_KEY=sk_test_REMPLACER_PAR_VRAIE_CLE
STRIPE_PUBLISHABLE_KEY=pk_test_REMPLACER_PAR_VRAIE_CLE
STRIPE_WEBHOOK_SECRET=whsec_REMPLACER_PAR_VRAIE_CLE

# ── BASE DE DONNÉES ──────────────────────────────────────────
DATABASE_URL=REMPLACER_PAR_URL_BASE44

# ── PROXY STRIPE (si nécessaire après test WEBHOOK-RAWBODY-01)
PROXY_PORT=3000
PROXY_BASE44_ENDPOINT=https://REMPLACER_PAR_ENDPOINT_BASE44

# ── MONITORING ───────────────────────────────────────────────
SENTRY_DSN=REMPLACER_SI_UTILISE
