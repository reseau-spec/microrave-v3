# MICRO RAVE V3 — Variables d'environnement
# ============================================================
# RÈGLE ABSOLUE : Ce fichier (.env) n'est JAMAIS versionné dans GitHub.
# Le fichier .env.example (sans valeurs réelles) est versionné.
# Copier .env.example → .env et remplir les valeurs réelles.
# ============================================================

# ── Base44 V3 ─────────────────────────────────────────────
# App : Micro Rave V3 — Backend
# appId : 6a09b5c6ace6051fecd365ae (public — dans le code)
# api_key : PRIVÉE — jamais dans GitHub
BASE44_V3_API_KEY=REMPLACER_PAR_LA_VRAIE_CLE

# ── Stripe ────────────────────────────────────────────────
# Clé secrète Stripe (sk_test_... ou sk_live_...)
STRIPE_SECRET_KEY=REMPLACER

# Webhook secret Stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=REMPLACER

# ── Proxy webhook ─────────────────────────────────────────
# URL Base44 endpoint qui reçoit les événements du proxy
# Format : https://app.base44.com/api/apps/{appId}/functions/stripeWebhook
PROXY_BASE44_ENDPOINT=REMPLACER

# Port du proxy webhook (défaut 3001)
PROXY_PORT=3001
