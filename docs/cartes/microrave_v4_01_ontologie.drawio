        <mxCell id="not_title" parent="1" style="text;html=1;align=center;strokeColor=#b85450;fillColor=#fde9e8;rounded=1;fontSize=12;fontStyle=1;" value="&lt;b&gt;🚫 Ce que Micro Rave n&#39;est PAS — les dérives architecturales à refuser&lt;/b&gt;" vertex="1">
          <mxGeometry height="32" width="1100" x="240" y="1003" as="geometry" />
        </mxCell>
        <mxCell id="not_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde9e8;strokeColor=#b85450;fontSize=11;align=center;" value="&lt;b&gt;❌ Pas une agence&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;MR ne fait pas de matching humain&lt;br/&gt;Le DecisionKernel automatise — il ne conseille pas&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="335" x="240" y="1045" as="geometry" />
        </mxCell>
        <mxCell id="not_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde9e8;strokeColor=#b85450;fontSize=11;align=center;" value="&lt;b&gt;❌ Pas une plateforme musicale&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;La musique est l&#39;instance initiale&lt;br/&gt;L&#39;invariant est universel — voir Pivot de Marché ci-haut&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="335" x="613" y="1045" as="geometry" />
        </mxCell>
        <mxCell id="not_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde9e8;strokeColor=#b85450;fontSize=11;align=center;" value="&lt;b&gt;❌ Pas un juge&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;MR est un greffier (Carte 00)&lt;br/&gt;Elle ne décide pas — elle prouve et archive&lt;/span&gt;" vertex="1">
