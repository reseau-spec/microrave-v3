        <mxCell id="engagement" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;strokeWidth=6;shadow=1;" value="&lt;b style=&#39;font-size:22px&#39;&gt;⚛️ L&#39;ENGAGEMENT — L&#39;ATOME · TOUT CONVERGE ICI&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:13px&#39;&gt;Le moment où une capacité culturelle locale devient un engagement vérifiable&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:12px&#39;&gt;&lt;b&gt;État : accepted · WORM 1&lt;/b&gt; — Le prix, le rôle, le style, l&#39;heure sont gravés dans le marbre.&lt;br/&gt;Le contrat numérique est créé (ContractSnapshot phase 1).&lt;br/&gt;À partir de cet instant : la machine d&#39;état prend le relais (Carte 02).&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="1100" x="240" y="699" as="geometry" />
        </mxCell>
        <mxCell id="produit_title" parent="1" style="text;html=1;align=center;strokeColor=#82b366;fillColor=#d5e8d4;rounded=1;fontSize=12;fontStyle=1;" value="&lt;b&gt;✅ Ce que l&#39;Engagement produit — les trois mémoires&lt;/b&gt;" vertex="1">
          <mxGeometry height="32" width="1100" x="240" y="851" as="geometry" />
        </mxCell>
        <mxCell id="prod_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" value="&lt;b&gt;💰 Mémoire économique&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Le waterfall (Carte 03)&lt;br/&gt;Le Ledger comptable&lt;br/&gt;L&#39;Invariant Zéro Cent&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="335" x="240" y="893" as="geometry" />
        </mxCell>
        <mxCell id="prod_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" value="&lt;b&gt;📊 Mémoire réputationnelle&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Le SOTS (Carte 05)&lt;br/&gt;Le ReputationLedger append-only&lt;br/&gt;7 dimensions de qualité&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="335" x="613" y="893" as="geometry" />
        </mxCell>
        <mxCell id="prod_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" value="&lt;b&gt;🗺️ Mémoire territoriale&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Le CheckpointTerritorial&lt;br/&gt;Le corridor local → réseau&lt;br/&gt;La densité avant la couverture&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="335" x="1005" y="893" as="geometry" />
