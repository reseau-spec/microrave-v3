<mxfile host="app.diagrams.net">
  <diagram id="carte01_v4" name="Page-1">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titre" parent="1" style="text;html=1;align=center;strokeColor=none;fillColor=none;" value="&lt;b style=&#39;font-size:20px&#39;&gt;Ce que Micro Rave est — et n&#39;est pas&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;color:#888;font-size:12px&#39;&gt;Carte 01 — Ontologie · V4_REFONTE · L&#39;invariant universel&lt;/span&gt;" vertex="1">
          <mxGeometry height="54" width="1100" x="240" y="20" as="geometry" />
        </mxCell>
        <mxCell id="pivot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=13;align=center;strokeWidth=5;shadow=1;" value="&lt;b style=&#39;font-size:18px&#39;&gt;🔄 PIVOT DE MARCHÉ — PROPRIÉTÉ ARCHITECTURALE&lt;/b&gt;&lt;br/&gt;&lt;b style=&#39;font-size:14px;color:#c00&#39;&gt;«Le domaine culturel est une instance. L&#39;invariant est universel.»&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:12px&#39;&gt;Remplacer musique par plomberie = quelques lignes de database. Zéro refonte de code.&lt;br/&gt;Si une feature rend ce pivot impossible, elle est architecturalement fautive.&lt;br/&gt;&lt;i&gt;Micro Rave n&#39;est pas une plateforme musicale — c&#39;est une infrastructure de confiance qui a commencé par la musique.&lt;/i&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="1100" x="240" y="88" as="geometry" />
        </mxCell>
        <mxCell id="voie_title" parent="1" style="text;html=1;align=center;strokeColor=#555;fillColor=#f5f5f5;rounded=1;fontSize=12;fontStyle=1;" value="&lt;b&gt;Les deux voies pour créer un engagement&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px;color:#555&#39;&gt;Deux chemins. Un seul atome produit.&lt;/span&gt;" vertex="1">
          <mxGeometry height="40" width="1100" x="240" y="220" as="geometry" />
        </mxCell>
        <mxCell id="voie_a_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;" value="&lt;b&gt;Voie A — CreateEvent&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#555;font-size:10px&#39;&gt;L&#39;organisateur cherche un talent&lt;/i&gt;" vertex="1">
          <mxGeometry height="50" width="500" x="240" y="286" as="geometry" />
        </mxCell>
        <mxCell id="voie_a_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" value="&lt;b&gt;1. L&#39;organisateur publie un besoin&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Lieu · date · budget · style musical&lt;br/&gt;Il cherche — il ne connaît pas encore&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="480" x="250" y="348" as="geometry" />
        </mxCell>
        <mxCell id="voie_a_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" value="&lt;b&gt;2. Le talent lève la main (proposed)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Il dit : je veux faire ça · son SOTS est visible&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="480" x="250" y="426" as="geometry" />
        </mxCell>
        <mxCell id="voie_a_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" value="&lt;b&gt;3. Négociation (negotiating)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Prix · rôle · style · heure · contre-offres possibles&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="480" x="250" y="494" as="geometry" />
        </mxCell>
        <mxCell id="voie_b_title" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;align=center;" value="&lt;b&gt;Voie B — QuickPlay&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#555;font-size:10px&#39;&gt;→ Ici, l&#39;initiative s&#39;inverse : c&#39;est la ressource qui propose, pas le demandeur&lt;/i&gt;" vertex="1">
          <mxGeometry height="50" width="500" x="780" y="285" as="geometry" />
        </mxCell>
        <mxCell id="voie_b_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" value="&lt;b&gt;1. Les talents forment une équipe (lobby)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Triple confirmation : roleMetier + style + cachet&lt;br/&gt;Chaque talent confirme son propre prix&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="480" x="790" y="348" as="geometry" />
        </mxCell>
        <mxCell id="voie_b_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" value="&lt;b&gt;2. L&#39;équipe envoie une offre groupée&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;MissionApplication collective — tout ou rien (voir Carte 04)&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="480" x="790" y="426" as="geometry" />
        </mxCell>
        <mxCell id="voie_b_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" value="&lt;b&gt;3. L&#39;organisateur dit OUI à tout ou NON à tout&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Pas de négociation individuelle. Il répond — il ne renégocie pas.&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="480" x="790" y="494" as="geometry" />
        </mxCell>
