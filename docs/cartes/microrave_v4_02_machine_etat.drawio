        <mxCell id="worm_hier" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#d6b656;fontSize=10;align=center;spacingLeft=6;" value="&lt;b&gt;🔒 Hiérarchie des WORM — pas tous équivalents&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;🔒 Niveau 1 &lt;br&gt;(ACCEPTED, DEPOSIT_SECURED, BALANCE_PENDING)&lt;br&gt;→ verrouille les engagements contractuels&lt;br&gt;Toucher = erreur&lt;/div&gt;&lt;div&gt;&lt;br&gt;🔒🔒 Niveau 2 &lt;br&gt;(EVENT_SEALED)&lt;br&gt;→ verrouille les flux financiers complets&lt;br&gt;Toucher = fraude&lt;/div&gt;&lt;div&gt;&lt;br&gt;🔒🔒🔒 Niveau 3 &lt;br&gt;(ARCHIVED)&lt;br&gt;→ verrouille tout pour toujours&lt;br&gt;Toucher = architecturalement impossible&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="346" x="1104" y="240" as="geometry" />
        </mxCell>
        <mxCell id="worm_expl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#d6b656;fontSize=10;align=center;spacingLeft=6;" value="&lt;b&gt;🔒 Qu&#39;est-ce qu&#39;un WORM ?&lt;/b&gt;&lt;br&gt;Write Once, Read Many.&lt;div&gt;&lt;br&gt;Comme écrire à l&#39;encre permanente.&lt;br&gt;Une fois écrit — on ne peut plus effacer.&lt;br&gt;On peut seulement lire.&lt;br&gt;Ça protège tout le monde contre la tricherie.&lt;br&gt;C&#39;est la différence entre une mémoire et un mensonge.&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="346" x="1104" y="490" as="geometry" />
        </mxCell>
