        <mxCell id="placed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" value="&lt;b&gt;📋 Le talent est inscrit dans le programme&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#555;font-size:10px&#39;&gt;placed — dans le Lineup&lt;/i&gt;" vertex="1">
