        <mxCell id="deposit_pending" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" value="&lt;b&gt;💳 En attente de l&#39;acompte&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#555;font-size:10px&#39;&gt;deposit_pending&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;L&#39;organisateur doit payer ≈20% pour réserver&lt;/span&gt;" vertex="1">
          <mxGeometry height="65" width="300" x="150" y="524" as="geometry" />
        </mxCell>
        <mxCell id="deposit_secured" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;strokeWidth=3;" value="&lt;b style=&#39;font-size:13px&#39;&gt;🔒 L&#39;acompte est reçu — le talent est réservé&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#a05000;font-size:10px&#39;&gt;deposit_secured · WORM niveau 1&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;L&#39;argent est protégé dans un coffre numérique.&lt;br/&gt;Les deux parties sont maintenant liées par contrat. Toucher ici = erreur.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="380" x="110" y="614" as="geometry" />
        </mxCell>
        <mxCell id="codependance" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#23527c;fontSize=12;align=center;strokeWidth=4;shadow=1;" value="&lt;b style=&#39;font-size:14px&#39;&gt;🔗 La co-dépendance fondamentale&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:12px&#39;&gt;Le paiement n&#39;existe que parce que la présence est prouvée.&lt;br/&gt;Tu n&#39;es pas payé parce que tu as signé.&lt;br/&gt;Tu es payé parce que tu étais là.&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px;color:#555&#39;&gt;C&#39;est le contrat fondamental de Micro Rave.&lt;br/&gt;Sans preuve de présence → zéro paiement. Toujours.&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="380" x="110" y="707" as="geometry" />
        </mxCell>
        <mxCell id="event_sealed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;strokeWidth=4;" value="&lt;b style=&#39;font-size:13px&#39;&gt;🔒🔒 Tout l&#39;argent est en sécurité — le show est confirmé&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#a05000;font-size:10px&#39;&gt;event_sealed · WORM niveau 2 — verrouille les flux financiers complets&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Toucher ici = fraude. Le contrat est complet (ContractSnapshot phase 2).&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="414" x="66" y="1013" as="geometry" />
        </mxCell>
        <mxCell id="performed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" value="&lt;b&gt;🎤 Le talent est sur scène — le show commence&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#555;font-size:10px&#39;&gt;performed&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;GPS · QR code · confirmation humaine&lt;br/&gt;LA PRÉSENCE EST PROUVÉE ICI.&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="300" x="150" y="1129" as="geometry" />
        </mxCell>
        <mxCell id="event_completed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;strokeWidth=3;" value="&lt;b style=&#39;font-size:13px&#39;&gt;🔒 Le show est terminé — tout le monde peut noter&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#a05000;font-size:10px&#39;&gt;event_completed · WORM niveau 1&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Fenêtre de 24h pour les notes SOTS.&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="380" x="110" y="1239" as="geometry" />
        </mxCell>
        <mxCell id="sots_closed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;strokeWidth=3;" value="&lt;b style=&#39;font-size:13px&#39;&gt;🔒 Les notes sont enregistrées pour toujours&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#a05000;font-size:10px&#39;&gt;sots_window_closed · WORM niveau 1&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;La réputation est mise à jour. Le système décide si payable.&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="380" x="110" y="1341" as="geometry" />
        </mxCell>
        <mxCell id="payable" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" value="&lt;b&gt;✅ Tout est vérifié — le talent peut être payé&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#3a7a2a;font-size:10px&#39;&gt;payable&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;11 conditions vérifiées (voir encart)&lt;br/&gt;PRÉSENCE PROUVÉE + ARGENT SÉCURISÉ = PAIEMENT&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="300" x="150" y="1458" as="geometry" />
        </mxCell>
        <mxCell id="settled" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" value="&lt;b&gt;💸 Le talent reçoit son argent&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#3a7a2a;font-size:10px&#39;&gt;settled&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Virement envoyé. Commission Micro Rave prélevée.&lt;br/&gt;Livres de compte équilibrés à zéro centime.&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="300" x="150" y="1548" as="geometry" />
