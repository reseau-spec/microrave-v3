        <mxCell id="payable" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" value="&lt;b&gt;✅ Tout est vérifié — le talent peut être payé&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#3a7a2a;font-size:10px&#39;&gt;payable&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;11 conditions vérifiées (voir encart)&lt;br/&gt;PRÉSENCE PROUVÉE + ARGENT SÉCURISÉ = PAIEMENT&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="300" x="150" y="1418" as="geometry" />
        </mxCell>
        <mxCell id="settled" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" value="&lt;b&gt;💸 Le talent reçoit son argent&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#3a7a2a;font-size:10px&#39;&gt;settled&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Virement envoyé. Commission Micro Rave prélevée.&lt;br/&gt;Livres de compte équilibrés à zéro centime.&lt;/span&gt;" vertex="1">
