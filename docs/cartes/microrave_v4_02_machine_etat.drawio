        <mxCell id="accepted" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;strokeWidth=3;" value="&lt;b style=&#39;font-size:13px&#39;&gt;🔒 ACCORD SIGNÉ — on ne change plus rien&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#a05000;font-size:10px&#39;&gt;accepted · WORM niveau 1&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Le prix, le rôle, le style, l&#39;heure sont gravés dans le marbre.&lt;br/&gt;ContractSnapshot phase 1. Toucher ici = erreur.&lt;/span&gt;" vertex="1">
