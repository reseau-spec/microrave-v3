        </mxCell>
        <mxCell id="event_completed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;strokeWidth=3;" value="&lt;b style=&#39;font-size:13px&#39;&gt;🔒 Le show est terminé — tout le monde peut noter&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#a05000;font-size:10px&#39;&gt;event_completed · WORM niveau 1&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Fenêtre de 24h pour les notes SOTS.&lt;/span&gt;" vertex="1">
          <mxGeometry height="75" width="380" x="110" y="1198" as="geometry" />
        </mxCell>
        <mxCell id="sots_closed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;align=center;fontStyle=1;strokeWidth=3;" value="&lt;b style=&#39;font-size:13px&#39;&gt;🔒 Les notes sont enregistrées pour toujours&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;color:#a05000;font-size:10px&#39;&gt;sots_window_closed · WORM niveau 1&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;La réputation est mise à jour. Le système décide si payable.&lt;/span&gt;" vertex="1">
