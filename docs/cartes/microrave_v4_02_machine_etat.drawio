        <mxCell id="mission_app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" value="&lt;b&gt;📤 Offre groupée envoyée&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;OUI à tout ou NON à tout — tout ou rien&lt;/span&gt;" vertex="1">
