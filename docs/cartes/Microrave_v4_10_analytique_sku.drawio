<mxCell id="etat_courtage" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;" value="&lt;b style='font-size:12px'&gt;📊 État 1 — Courtage&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Moteur : transaction (Engagement archivé)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Unité : Engagement archivé&lt;br/&gt;Revenu reconnu : à l&apos;archivage (LOI LEDGER-01)&lt;br/&gt;Compte : 7110–7190&lt;br/&gt;&lt;br/&gt;Par RoleSKU × StyleSKU × PlageHoraireSKU :&lt;br/&gt;GMV brut · Commission MR · Frais Stripe&lt;br/&gt;Marge brute · Taux no-show · GMV médian&lt;br/&gt;&lt;br/&gt;Source : FinancialLedger(7110) × EngagementSKUTag" vertex="1">
  <mxGeometry x="20" y="780" width="480" height="180" as="geometry"/>
</mxCell>

<!-- État 2 : SaaS -->
<mxCell id="etat_saas" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=10;" value="&lt;b style='font-size:12px'&gt;📦 État 2 — SaaS Membership&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Moteur : période (mois / année)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Unité : période de membership&lt;br/&gt;Revenu reconnu : pro-rata quotidien (D-050)&lt;br/&gt;Compte : 7210–7240 | Différé : 4535&lt;br/&gt;&lt;br/&gt;Par MembershipPlan (Freemium/Pro/Studio) :&lt;br/&gt;Revenu SaaS reconnu · Revenu différé restant&lt;br/&gt;&lt;br/&gt;Source : FinancialLedger(7210+) × UserMembership&lt;br/&gt;&lt;br/&gt;&lt;i style='color:#888'&gt;Séparé du courtage — horloge différente&lt;/i&gt;" vertex="1">
  <mxGeometry x="520" y="780" width="480" height="180" as="geometry"/>
</mxCell>

<!-- Corrélation -->
<mxCell id="etat_correlation" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=10;" value="&lt;b style='font-size:12px'&gt;🔗 Corrélation inter-moteurs&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Tableau de bord stratégique — JAMAIS comptabilité&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Question type :&lt;br/&gt;&lt;i&gt;Les talents PRO génèrent-ils 3× plus de GMV&lt;br/&gt;courtage dans les 12 mois post-upgrade ?&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Analyse : EngagementSKUTag.membershipTier&lt;br/&gt;× LedgerEntry(7110) · par cohorte d&apos;activation&lt;br/&gt;&lt;br/&gt;⚠️ Requête inter-moteurs exige paramètre&lt;br/&gt;&lt;b&gt;labelInterMoteur&lt;/b&gt; explicite — sinon rejeté&lt;br/&gt;par LedgerReportingService (D-155)" vertex="1">
  <mxGeometry x="1020" y="780" width="600" height="180" as="geometry"/>
</mxCell>

