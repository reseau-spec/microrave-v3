<mxCell id="cal_structure" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=11;" value="&lt;b&gt;Structure&lt;/b&gt;&lt;br/&gt;4 trimestres × 13 semaines = 52 semaines = 364 jours&lt;br/&gt;Chaque trimestre : 3 périodes de 4 + 4 + 5 semaines&lt;br/&gt;&lt;br/&gt;Q1 : W01–W13 · Q2 : W14–W26&lt;br/&gt;Q3 : W27–W39 · Q4 : W40–W52 (+overflow)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Débordement :&lt;/b&gt; absorbé dans Q4&lt;br/&gt;2028 : Q4 = 4-4-6 · 2034 : idem" vertex="1">
  <mxGeometry x="20" y="540" width="380" height="160" as="geometry"/>
</mxCell>

<mxCell id="cal_ancres" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3949ab;fontSize=10;" value="&lt;b&gt;Ancres validées&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;2026 → 2026-01-05 lun · 52 sem&lt;br/&gt;2027 → 2027-01-04 lun · 52 sem&lt;br/&gt;2028 → 2028-01-03 lun · 53 sem ⚠️&lt;br/&gt;2029 → 2029-01-08 lun · 52 sem&lt;br/&gt;2030 → 2030-01-07 lun · 52 sem&lt;br/&gt;&lt;br/&gt;&lt;i style='font-size:9px'&gt;Gravées dans CalendarAnchorConfig (CAL-)&lt;br/&gt;Jamais recalculées à la volée&lt;/i&gt;" vertex="1">
  <mxGeometry x="420" y="540" width="280" height="160" as="geometry"/>
</mxCell>

