<!-- TITRE -->
<mxCell id="titre" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" value="&lt;b style='font-size:18px'&gt;Analytique et États Financiers par SKU&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#888;font-size:11px'&gt;Carte 10 — BLOC 19 · D-148 à D-155 · OS V15 · LOI SKU-MOTEUR-01 · LOI CALENDRIER-445-01 · LOI SKU-ATOME-01&lt;/span&gt;" vertex="1">
  <mxGeometry x="20" y="20" width="1600" height="60" as="geometry"/>
</mxCell>

<!-- LOI FONDATRICE -->
<mxCell id="loi_fond" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=11;fontStyle=1;" value="&lt;b style='font-size:14px'&gt;⚠️ LOI SKU-MOTEUR-01 — Non-contamination des moteurs économiques&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Un abonnement SaaS et un événement transigé ne partagent ni la même unité de temps, ni la même unité de valeur, ni la même causalité.&lt;br/&gt;Les mélanger dans un même état de rentabilité sans étiquette explicite produit une métrique composite qui trompe tout le monde, les investisseurs les premiers.&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;La corrélation inter-moteurs est une analyse stratégique — jamais une ligne comptable." vertex="1">
  <mxGeometry x="20" y="100" width="1600" height="80" as="geometry"/>
</mxCell>

<!-- SECTION 1 : TRIPTYQUE SKU -->
<mxCell id="s1_titre" parent="1" style="text;html=1;strokeColor=none;fillColor=#e3f2fd;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1;" value="① LE TRIPTYQUE SKU — Trois dimensions orthogonales et indépendantes · LOI SKU-ATOME-01" vertex="1">
  <mxGeometry x="20" y="210" width="1600" height="36" as="geometry"/>
</mxCell>

<!-- RoleSKU -->
<mxCell id="role_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;" value="&lt;b style='font-size:13px'&gt;🎭 RoleSKU · D-150&lt;/b&gt;&lt;br/&gt;&lt;i style='font-size:10px;color:#1b5e20'&gt;Préfixe RSK- · WORM de nomenclature&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;QUI&lt;/b&gt; est engagé&lt;br/&gt;&lt;br/&gt;DJ · HUMORISTE · MC&lt;br/&gt;SOUNDTECH · VJ · PHOTOGRAPHE&lt;br/&gt;ANIMATEUR · MUSICIEN · ...&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:9px;color:#555'&gt;Codes définis en database — jamais hardcodés.&lt;br/&gt;Ajout via PolicyConfigChangeRecord + Admin + Fondateur.&lt;br/&gt;Code immuable une fois créé.&lt;/span&gt;" vertex="1">
  <mxGeometry x="20" y="260" width="300" height="200" as="geometry"/>
</mxCell>

<!-- StyleSKU -->
<mxCell id="style_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=11;" value="&lt;b style='font-size:13px'&gt;🎵 StyleSKU · D-151&lt;/b&gt;&lt;br/&gt;&lt;i style='font-size:10px;color:#4a148c'&gt;Préfixe SSK- · Relation N:M avec rôles&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;COMMENT&lt;/b&gt; la prestation est exécutée&lt;br/&gt;&lt;br/&gt;HOUSE · TECHNO · DISCO · JAZZ&lt;br/&gt;STAND_UP · IMPROVISATION&lt;br/&gt;LATIN · R&amp;amp;B · POP · ...&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:9px;color:#555'&gt;Un style peut appartenir à plusieurs rôles (N:M).&lt;br/&gt;Ex : IMPROVISATION → HUMORISTE + MC + ANIMATEUR.&lt;br/&gt;Style sans rôle = rejeté (fail-closed).&lt;/span&gt;" vertex="1">
  <mxGeometry x="340" y="260" width="300" height="200" as="geometry"/>
</mxCell>

<!-- PlageHoraireSKU -->
<mxCell id="plage_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#01579b;fontSize=11;" value="&lt;b style='font-size:13px'&gt;🕐 PlageHoraireSKU · D-149&lt;/b&gt;&lt;br/&gt;&lt;i style='font-size:10px;color:#01579b'&gt;Préfixe PSK- · Calendrier 4-4-5 (D-148)&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;QUAND&lt;/b&gt; la prestation est livrée&lt;br/&gt;&lt;br/&gt;Format : {ANNEE}Q{Q}W{WW}{J}B{B}&lt;br/&gt;Ex : 2026Q1W065B6 = Ven W06 soirée&lt;br/&gt;6 blocs de 4h · 2 184 SKUs/an&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:9px;color:#555'&gt;B1 00–04h NUIT · B2 04–08h AUBE&lt;br/&gt;B3 08–12h MATIN · B4 12–16h APRÈS-MIDI&lt;br/&gt;B5 16–20h FIN-APM · B6 20–00h SOIRÉE&lt;/span&gt;" vertex="1">
  <mxGeometry x="660" y="260" width="300" height="200" as="geometry"/>
</mxCell>

<!-- EngagementSKUTag -->
<mxCell id="tag_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;fontSize=11;" value="&lt;b style='font-size:13px'&gt;🔒 EngagementSKUTag · D-152&lt;/b&gt;&lt;br/&gt;&lt;i style='font-size:10px;color:#b71c1c'&gt;Préfixe EST- · WORM gravé à ACCEPTED&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;Jointure analytique immuable&lt;br/&gt;Créé simultanément au ContractSnapshot phase 1&lt;br/&gt;&lt;br/&gt;roleSKUCode · styleSKUCode&lt;br/&gt;plageHoraireSKUs (1 ou 2 blocs)&lt;br/&gt;membershipTier (snapshot)&lt;br/&gt;capturedAt [immuable]&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:9px;color:#555'&gt;Fail-closed : si tag impossible → transition bloquée.&lt;br/&gt;Correction via SKUCorrectionRecord (tag original intact).&lt;/span&gt;" vertex="1">
  <mxGeometry x="980" y="260" width="300" height="200" as="geometry"/>
</mxCell>

<!-- Exemple concret -->
<mxCell id="exemple_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#616161;fontSize=10;" value="&lt;b&gt;Exemple : DJ Alex · House · Vendredi 22h–02h · W06 2026&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;RoleSKU    → RSK-DJ&lt;br/&gt;StyleSKU   → SSK-HOUSE&lt;br/&gt;PlageSKU 1 → PSK-2026Q1W065B6  (Ven 20h–00h SOIRÉE)&lt;br/&gt;PlageSKU 2 → PSK-2026Q1W066B1  (Sam 00h–04h NUIT)&lt;br/&gt;&lt;br/&gt;= 3 SKU distincts pour 1 prestation&lt;br/&gt;&lt;i style='color:#888'&gt;même clé en 2027 : 2027Q1W065B6 · pommes / pommes&lt;/i&gt;" vertex="1">
  <mxGeometry x="1300" y="260" width="320" height="200" as="geometry"/>
</mxCell>

