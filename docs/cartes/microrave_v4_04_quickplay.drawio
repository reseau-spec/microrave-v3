          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pa" edge="1" parent="1" source="sa8" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;strokeWidth=2;" target="pipeline">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pb" edge="1" parent="1" source="sb6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;strokeWidth=2;" target="pipeline">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
