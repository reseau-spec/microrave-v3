        <mxCell id="rep_title" parent="1" style="text;html=1;align=center;strokeColor=#6c8ebf;fillColor=#dae8fc;rounded=1;fontSize=12;fontStyle=1;" value="&lt;b&gt;📒 Comment la réputation est stockée · section 5.1&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1300" x="150" y="759" as="geometry" />
        </mxCell>
        <mxCell id="rep_ledger" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" value="&lt;b&gt;📒 Le carnet permanent&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#6a0080&#39;&gt;ReputationLedger — append-only · 🟢 VALIDÉ&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Chaque note = une ligne ajoutée pour toujours.&lt;br/&gt;Note fausse → correction (reversal) ajoutée.&lt;br/&gt;L&#39;originale reste. Jamais suppression.&lt;br/&gt;Garde le POURQUOI.&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="390" x="150" y="797" as="geometry" />
        </mxCell>
        <mxCell id="rep_snapshot" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" value="&lt;b&gt;📸 Le score calculé&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#3a7a2a&#39;&gt;SOTSScoreSnapshot — recalculé à chaque note · 🟢 VALIDÉ&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Score affiché = 1 chiffre sur 5 · pondéré depuis SOTSDimensionConfig.weight_ppm&lt;br/&gt;Tout acteur entrant = 3/5 = neutre (1 000 000 ppm)&lt;br/&gt;Score global + score par rôle séparés (byRole)&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="390" x="555" y="797" as="geometry" />
        </mxCell>
        <mxCell id="rep_qui" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" value="&lt;b&gt;🧑‍⚖️ Qui peut noter qui ?&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px&#39;&gt;Relation réelle obligatoire · section 5.3&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;Audience → Talent(s), Checkpoint&lt;br/&gt;Talent → Organisateur, Checkpoint&lt;br/&gt;Organisateur → Talent(s)&lt;br/&gt;Payeur → Organisateur, Vendeur&lt;br/&gt;Admin → Tout acteur (SOTS_ADJUSTMENT)&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="390" x="960" y="797" as="geometry" />
        </mxCell>
        <mxCell id="phrase_canonique" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;strokeWidth=4;shadow=1;" value="&lt;b style=&quot;font-size:14px&quot;&gt;🏛️ Ce que le SOTS mémorise — la phrase canonique&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:13px&quot;&gt;Le SOTS mesure ce qui a été livré, comment cela a été livré, et à quel point c&#39;était bon — par qui, dans quel rôle, dans quel lieu, ressenti par qui — pour les talents, les lieux, les rôles et les styles.&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Le ReputationLedger garde tout ça pour toujours.&lt;br&gt;Le seuil de confiance décide quand ce score peut toucher l&#39;argent.&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="1300" x="150" y="915" as="geometry" />
        </mxCell>
        <mxCell id="doctrinaux" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555;fontSize=10;align=left;spacingLeft=6;" value="&lt;b&gt;Statuts doctrinaux&lt;/b&gt;&lt;br/&gt;🟢 VALIDÉ V7_FINAL&lt;br/&gt;🟡 SEED CONFIGURABLE&lt;br/&gt;🔶 CONFIG VALUE REQUIRED&lt;br/&gt;🔴 INTERDIT ABSOLU" vertex="1">
          <mxGeometry height="90" width="180" x="150" y="1043" as="geometry" />
        </mxCell>
        <mxCell id="lois_app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" value="&lt;b&gt;Lois de cette carte :&lt;/b&gt; SOTS-01 · REPUTATION-LEDGER-01 · DONNEE-TEMOIN-01 · BICOUCHE-01&lt;br/&gt;&lt;i&gt;Interdits : voir Carte 06 § interdits 12-16 · Lois invariantes : Carte 08 loi 4 (donnée-témoin)&lt;/i&gt;" vertex="1">
