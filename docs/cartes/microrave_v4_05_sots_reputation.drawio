        <mxCell id="titre" parent="1" style="text;html=1;align=center;strokeColor=none;fillColor=none;" value="&lt;b style=&#39;font-size:18px&#39;&gt;Comment la réputation d&#39;un talent est construite, gardée et utilisée&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;color:#888;font-size:11px&#39;&gt;Carte 05 — SOTS · Spirit of the Sound · Micro Rave V4_REFONTE&lt;/span&gt;" vertex="1">
          <mxGeometry height="50" width="1300" x="150" y="10" as="geometry" />
        </mxCell>
        <mxCell id="bandeau_temoin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a2a4a;strokeColor=#2c4a8c;fontSize=13;align=center;strokeWidth=5;shadow=1;fontColor=#ffffff;" value="&lt;b style=&#39;font-size:20px;color:#ffffff&#39;&gt;📊 Le SOTS est une donnée-témoin — pas une donnée-pétrole&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:13px;color:#aaccff&#39;&gt;Une donnée-pétrole est extraite à ton insu, raffinée, vendue, disparue. Elle ne te représente pas — elle te réduit.&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:12px;color:#dddddd&#39;&gt;Une donnée-témoin est co-produite avec ton consentement, conservée pour toujours, contestable par procédure, portée par ceux qui l&#39;ont vécue.&lt;br/&gt;Le SOTS ne mesure pas ton comportement. Il mémorise ce que des personnes réelles ont vécu avec toi, en ta présence, vérifiée.&lt;br/&gt;&lt;b style=&#39;color:#ffffff&#39;&gt;C&#39;est la différence entre un score Uber et une mémoire culturelle.&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="130" width="1300" x="150" y="74" as="geometry" />
        </mxCell>
        <mxCell id="bicouche_title" parent="1" style="text;html=1;align=center;strokeColor=#9673a6;fillColor=#e1d5e7;rounded=1;fontSize=12;fontStyle=1;" value="&lt;b&gt;🏗️ Architecture bi-couche — ce qui touche l&#39;argent et ce qui ne le touche jamais&lt;/b&gt;" vertex="1">
          <mxGeometry height="34" width="1300" x="150" y="222" as="geometry" />
        </mxCell>
        <mxCell id="couche1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;strokeWidth=3;" value="&lt;b style=&#39;font-size:14px&#39;&gt;💰 COUCHE 1 — Quantitative (peut toucher l&#39;argent)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;SOTSQuantitativeRecord → après 10 notes → SOTSCommissionModulationConfig&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px&#39;&gt;Les 7 dimensions notées de 1 à 5 · Le score global et par rôle&lt;br/&gt;Les 4 seuils de confiance · La modulation de commission&lt;br/&gt;&lt;b&gt;Cette couche est marchande. Elle a des règles strictes.&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="630" x="150" y="264" as="geometry" />
        </mxCell>
        <mxCell id="couche2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;strokeWidth=3;" value="&lt;b style=&#39;font-size:14px&#39;&gt;📝 COUCHE 2 — Qualitative (ne touche JAMAIS l&#39;argent)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;SOTSQualitativeRecord → archive sémantique → mémoire culturelle&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px&#39;&gt;Champs libres · &#39;le pain était bon&#39; · &#39;ambiance incroyable&#39; · &#39;son parfait&#39;&lt;br/&gt;Archivé append-only. Traitement sémantique différé.&lt;br/&gt;&lt;b&gt;Cette couche est le portrait. Elle ne se monétise pas.&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="630" x="820" y="264" as="geometry" />
        </mxCell>
        <mxCell id="sots_def" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" value="&lt;b style=&#39;font-size:13px&#39;&gt;⭐ C&#39;est quoi le SOTS ? · Spirit of the Sound · section 5.0&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:11px;color:#6a0080&#39;&gt;Clin d&#39;œil au Spirit of the Game du ultimate frisbee : pas d&#39;arbitre externe — les acteurs témoignent eux-mêmes.&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px&#39;&gt;La mémoire est co-produite. Le fair play est architecturé.&lt;br/&gt;&lt;b&gt;Règle d&#39;or : tu ne peux pas noter une expérience que le système ne t&#39;a pas vu vivre.&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="1300" x="150" y="372" as="geometry" />
        </mxCell>
        <mxCell id="dim_title" parent="1" style="text;html=1;align=center;strokeColor=#9673a6;fillColor=#e1d5e7;rounded=1;fontSize=12;fontStyle=1;" value="&lt;b&gt;📊 Les 7 dimensions — 🟡 SEED CONFIGURABLE dans SOTSDimensionConfig — jamais hardcodées&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="1300" x="150" y="476" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" value="La performance&lt;br/&gt;était-elle bonne ?&lt;br/&gt;&lt;i style=&#39;font-size:9px;color:#6a0080&#39;&gt;performance_artistique&lt;/i&gt;" vertex="1">
