        <mxCell id="s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;align=center;strokeWidth=2;" value="&lt;b style=&#39;font-size:18px&#39;&gt;10&lt;/b&gt;&lt;br/&gt;notes&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;💰 COUCHE 1 ACTIVÉE&lt;br/&gt;Modulation commission&lt;br/&gt;🔶 CONFIG VALUE REQUIRED&lt;/span&gt;" vertex="1">
