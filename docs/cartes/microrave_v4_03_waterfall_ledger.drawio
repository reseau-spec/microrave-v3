<mxfile host="app.diagrams.net">
  <diagram id="carte03_v4" name="Page-1">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titre" parent="1" style="text;html=1;align=center;strokeColor=none;fillColor=none;" value="&lt;b style=&#39;font-size:18px&#39;&gt;Comment l&#39;argent est calculé, distribué et enregistré&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;color:#888;font-size:11px&#39;&gt;Carte 03 — Waterfall et Ledger · V4_REFONTE · LOI WATERFALL-01 · LOI LEDGER-01 · LOI LEDGER-02&lt;/span&gt;" vertex="1">
          <mxGeometry height="54" width="1200" x="200" y="14" as="geometry" />
        </mxCell>
        <mxCell id="invariant_zero" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=center;strokeWidth=5;shadow=1;" value="&lt;b style=&#39;font-size:20px&#39;&gt;⚖️ L&#39;Invariant Fondamental — pas un centime ne peut disparaître&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:13px&#39;&gt;Chaque dollar qui entre doit sortir vers une destination nommée. Les livres tombent à zéro. Toujours.&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:12px&#39;&gt;La comptabilité n&#39;est pas un outil de contrôle — c&#39;est une promesse de transparence.&lt;br/&gt;Si les livres ne tombent pas à zéro, le show ne peut pas être archivé. L&#39;argent ne disparaît pas. Il est prouvé.&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="1200" x="200" y="82" as="geometry" />
        </mxCell>
        <mxCell id="standard_num" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;align=center;strokeWidth=3;" value="&lt;b style=&#39;font-size:14px&#39;&gt;📏 Standard Numérique Invariant — à lire AVANT les formules · section 3.2&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:12px&#39;&gt;&lt;b&gt;MONEY&lt;/b&gt; = centimes entiers (JAMAIS 1000,00$ — TOUJOURS 100 000 centimes)&lt;br/&gt;&lt;b&gt;RATE&lt;/b&gt; = ppm (12% = 120 000 ppm) · &lt;b&gt;floor&lt;/b&gt; sur commissions MR · &lt;b&gt;ceil&lt;/b&gt; sur frais Stripe&lt;br/&gt;&lt;b&gt;JAMAIS&lt;/b&gt; virgule flottante. Un développeur qui l&#39;ignore introduira des bugs de centimes qui violeront l&#39;Invariant Fondamental.&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="1200" x="200" y="210" as="geometry" />
        </mxCell>
        <mxCell id="exemple" parent="1" style="text;html=1;align=center;strokeColor=#0050a0;fillColor=#dae8fc;rounded=1;fontSize=12;fontStyle=1;" value="&lt;b&gt;Exemple de référence : 1 talent signé à 1 000$ · taux MR 12% · show vendu 1 500$ à QC&lt;/b&gt;" vertex="1">
          <mxGeometry height="32" width="1200" x="200" y="318" as="geometry" />
        </mxCell>
        <mxCell id="legende" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555;fontSize=11;align=left;spacingLeft=8;" value="&lt;b&gt;Couleurs&lt;/b&gt;&lt;br/&gt;🔵 Calcul talent&lt;br/&gt;🟡 Taxes / frais&lt;br/&gt;🟢 Ce que le talent reçoit&lt;br/&gt;🟠 Règle verrouillée&lt;br/&gt;🔴 Interdit absolu" vertex="1">
          <mxGeometry height="105" width="160" x="200" y="358" as="geometry" />
        </mxCell>
        <mxCell id="w1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="&lt;b&gt;① Est-ce qu&#39;on a vendu plus que les cachets ?&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#0050a0&#39;&gt;coefficient = max(1, prix_vendu / total_lineup_effectif) · LOI LINEUP-01&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px&#39;&gt;1 500 / 1 000 = &lt;b&gt;coefficient 1,5&lt;/b&gt; → tout le lineup monte de 50%&lt;br/&gt;Si vendu = signé → coefficient = 1 → rien ne change&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="380" x="380" y="358" as="geometry" />
        </mxCell>
        <mxCell id="w2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="&lt;b&gt;② Vrai cachet de chaque talent&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#0050a0&#39;&gt;cachet_brut_final_i = cachet_signé_i × coefficient&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px&#39;&gt;1 000$ × 1,5 = &lt;b&gt;1 500$ brut&lt;/b&gt;&lt;br/&gt;Si talent gratuit → formule deux couches (voir droite)&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="380" x="380" y="455" as="geometry" />
        </mxCell>
        <mxCell id="w3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="&lt;b&gt;③ Micro Rave prend sa commission&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#0050a0&#39;&gt;commission_MR_i = floor(cachet_brut_final_i × taux / 1 000 000)&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px&#39;&gt;floor(150 000 × 120 000 / 1 000 000) = &lt;b&gt;18 000¢ = 180$&lt;/b&gt;&lt;br/&gt;floor = arrondi vers le bas — MR ne sur-prélève jamais&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="380" x="380" y="548" as="geometry" />
        </mxCell>
        <mxCell id="w4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;strokeWidth=2;" value="&lt;b&gt;④ Ce que le talent reçoit vraiment&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#3a7a2a&#39;&gt;talent_net_i = cachet_brut_final_i − commission_MR_i&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px&#39;&gt;1 500$ − 180$ = &lt;b&gt;1 320$ net&lt;/b&gt;&lt;br/&gt;Ce n&#39;est pas un 2ème calcul — c&#39;est le reste protégé.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="380" x="380" y="640" as="geometry" />
        </mxCell>
        <mxCell id="w5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" value="&lt;b&gt;⑤ Total commissions MR · vendeur hors waterfall&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#0050a0&#39;&gt;LOI SELLER-COMP-01 — le vendeur reçoit 0$ du waterfall&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px&#39;&gt;Sa rémunération vient de SellerCompensationPlan (budget séparé).&lt;br/&gt;C&#39;est la réponse à la Loi de Goodhart.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="380" x="380" y="732" as="geometry" />
        </mxCell>
        <mxCell id="w6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" value="&lt;b&gt;⑥ Taxes — sur le prix total, pas sur la commission&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#7a6000&#39;&gt;TaxLiabilityAllocation selon juridiction · section 3.10&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px&#39;&gt;QC : TPS 5% × 1 500$ = 75$ · TVQ 9,975% × 1 500$ = 149,63$&lt;br/&gt;Base taxable = prix vendu total. Jamais la commission seule.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="380" x="380" y="824" as="geometry" />
        </mxCell>
        <mxCell id="w7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" value="&lt;b&gt;⑦ Sous-total avant frais Stripe&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#7a6000&#39;&gt;sous_total = prix_vendu_client + taxes applicables&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px&#39;&gt;1 500$ + 75$ + 149,63$ = &lt;b&gt;1 724,63$&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="380" x="380" y="922" as="geometry" />
        </mxCell>
        <mxCell id="w8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" value="&lt;b&gt;⑧ Frais Stripe (avancés pour le client)&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#7a6000&#39;&gt;frais_stripe = ceil(sous_total × stripe_ppm) · DEBOURS&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px&#39;&gt;ceil = arrondi vers le haut — MR ne paie jamais plus qu&#39;elle collecte. &lt;b&gt;= 45$&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="380" x="380" y="1014" as="geometry" />
        </mxCell>
        <mxCell id="w9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;strokeWidth=2;" value="&lt;b&gt;⑨ Ce que le client paie en tout&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#0050a0&#39;&gt;total_payeur = sous_total + frais_stripe&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px&#39;&gt;1 724,63$ + 45$ = &lt;b&gt;1 769,63$&lt;/b&gt; — c&#39;est le montant sur la facture du client.&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="380" x="380" y="1106" as="geometry" />
        </mxCell>
        <mxCell id="ledger_check" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;strokeWidth=4;shadow=1;" value="&lt;b style=&#39;font-size:16px&#39;&gt;⚖️ LOI LEDGER-02 — contrôle final : tout s&#39;équilibre à zéro centime&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:12px;color:#3a7a2a&#39;&gt;sum(nets) + sum(commissions_MR) + rounding_adjustment = prix_vendu_client&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:12px&#39;&gt;1 320$ + 180$ = 1 500$ ✅ · Si non respecté → LEDGER_BALANCE_VIOLATION → event_sealed BLOQUÉ&lt;br/&gt;&lt;b&gt;L&#39;Invariant Fondamental s&#39;applique : les livres tombent à zéro. Toujours.&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="1200" x="200" y="1207" as="geometry" />
        </mxCell>
        <mxCell id="ledger_title" parent="1" style="text;html=1;align=center;strokeColor=#0050a0;fillColor=#dae8fc;rounded=1;fontSize=12;fontStyle=1;" value="&lt;b&gt;📒 LOI LEDGER-01&lt;br&gt;Le revenu n&#39;est reconnu qu&#39;à l&#39;archivage · Section 4.1&lt;/b&gt;" vertex="1">
          <mxGeometry height="52" width="400" x="1000" y="358" as="geometry" />
        </mxCell>
        <mxCell id="moment1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" value="&lt;b&gt;💰 MOMENT 1 — L&#39;argent arrive (encaissement)&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#0050a0&#39;&gt;Client paye 1 769,63$ · tout entre dans 5200&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-family:monospace;font-size:10px&#39;&gt;DR 5200  Stripe en attente   +1 769,63$&lt;br/&gt;  CR 4310  Talent payable net   -1 320,00$&lt;br/&gt;  CR 4325  TPS — pour l&#39;État       -75,00$&lt;br/&gt;  CR 4326  TVQ — pour l&#39;État      -149,63$&lt;br/&gt;  CR 4530  Commission MR différée  -180,00$&lt;br/&gt;  CR 4190  Frais Stripe transit     -45,00$&lt;br/&gt;&lt;b&gt;1320+75+149,63+180+45 = 1769,63$ ✅&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="148" width="400" x="1000" y="421" as="geometry" />
        </mxCell>
        <mxCell id="moment2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" value="&lt;b&gt;📦 MOMENT 2 — L&#39;argent repart (archivage) — 5 mouvements&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#3a7a2a&#39;&gt;Tout sort de 5200. À la fin : 5200 = 0$&lt;/i&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px&#39;&gt;&lt;b&gt;① Stripe reprend ses frais :&lt;/b&gt; DR 4190 · CR 5200 — 45$&lt;br/&gt;&lt;b&gt;② Taxes à l&#39;État :&lt;/b&gt; DR 4325 + DR 4326 · CR 5200 — 224,63$&lt;br/&gt;&lt;b&gt;③ Talent payé :&lt;/b&gt; DR 4310 · CR 5200 — 1 320$&lt;br/&gt;&lt;b&gt;④ Commission MR → banque :&lt;/b&gt; DR 5100 · CR 5200 — 180$&lt;br/&gt;&lt;b&gt;⑤ Commission reconnue :&lt;/b&gt; DR 4530 · CR 7110 — 180$&lt;/span&gt;" vertex="1">
          <mxGeometry height="138" width="400" x="1000" y="578" as="geometry" />
        </mxCell>
        <mxCell id="solde" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;strokeWidth=3;" value="&lt;b&gt;Compte 5200 · Solde final&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-family:monospace;font-size:11px&#39;&gt;+1769,63$ encaissement&lt;br/&gt;−   45,00$ (①)&lt;br/&gt;−  224,63$ (②)&lt;br/&gt;−1 320,00$ (③)&lt;br/&gt;−  180,00$ (④)&lt;br/&gt;&lt;b style=&#39;font-size:18px;color:#006600&#39;&gt;= 0,00$ ✅&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="138" width="195" x="1000" y="732" as="geometry" />
        </mxCell>
        <mxCell id="solde4190" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" value="&lt;b&gt;Compte 4190 · Solde final&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-family:monospace;font-size:11px&#39;&gt;+45$ CR (encaissement)&lt;br/&gt;−45$ DR (mouvement ①)&lt;br/&gt;&lt;b style=&#39;font-size:18px;color:#006600&#39;&gt;= 0,00$ ✅&lt;/b&gt;&lt;/span&gt;&lt;br/&gt;&lt;span style=&#39;font-size:9px&#39;&gt;4190 = débours en transit. Jamais une charge MR.&lt;/span&gt;" vertex="1">
          <mxGeometry height="138" width="195" x="1205" y="732" as="geometry" />
        </mxCell>
        <mxCell id="cas_spec" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" value="&lt;b&gt;🎁 Cas spéciaux : talent signé à 0$ · LOI LINEUP-02&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:10px&#39;&gt;&lt;b&gt;Cas 1 — 2 talents gratuits · vendu 1 000$&lt;/b&gt;&lt;br/&gt;surplus = 1 000$ réparti à 50/50 → A net 440$, B net 440$ ✅&lt;br/&gt;&lt;b&gt;Cas 2 — A=1 000$, B gratuit · vendu 1 000$&lt;/b&gt;&lt;br/&gt;surplus = 0$ → A = 1 000$ (contrat préservé) ✅&lt;br/&gt;&lt;b&gt;Cas 3 — A=1 000$, B gratuit · vendu 2 000$&lt;/b&gt;&lt;br/&gt;surplus = 1 000$ → A ≈ 1 999$, B ≈ 1$ ✅&lt;br/&gt;Le gratuit ne réduit jamais le payé.&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="400" x="1000" y="880" as="geometry" />
        </mxCell>
        <mxCell id="interdits" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde9e8;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=6;" value="&lt;b&gt;🚫 Interdits absolus · section 3.3&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;font-size:11px&#39;&gt;❌ TPS = commission_MR × tps_ppm (faux — base taxable = prix total)&lt;br/&gt;❌ DR 6110 / CR 4190 sous doctrine DEBOURS&lt;br/&gt;❌ 4410/4420 à l&#39;encaissement sous Doctrine A&lt;br/&gt;❌ Virgule flottante dans les calculs monétaires&lt;/span&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px&#39;&gt;Voir aussi Carte 06 § interdits 4-6&lt;/i&gt;" vertex="1">
          <mxGeometry height="126" width="400" x="1000" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="lois_app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;" value="&lt;b&gt;Lois de cette carte :&lt;/b&gt; WATERFALL-01 · LEDGER-01 · LEDGER-02 · LINEUP-01 · LINEUP-02 · SELLER-COMP-01&lt;br/&gt;&lt;i&gt;L&#39;Invariant Fondamental s&#39;applique à tout calcul. Voir Carte 08 pour le registre complet.&lt;/i&gt;" vertex="1">
          <mxGeometry height="40" width="780" x="200" y="1317" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="invariant_zero" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;strokeWidth=2;" target="standard_num">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
