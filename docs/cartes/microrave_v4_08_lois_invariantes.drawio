<mxfile host="app.diagrams.net">
  <diagram id="ATgPbnH33ph1rCZ2jeoN" name="Page-1">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titre" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=28;fontColor=#FFD700;fontStyle=1;" value="&lt;b&gt;CARTE 08 — CE QUI NE CHANGERA JAMAIS&lt;/b&gt;" vertex="1">
          <mxGeometry height="44" width="1614" x="20" y="18" as="geometry" />
        </mxCell>
        <mxCell id="soustitre" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#aaaaaa;fontStyle=2;" value="Les lois invariantes de Micro Rave — Elles n&#39;ont pas été décidées. Elles ont été découvertes." vertex="1">
          <mxGeometry height="26" width="1614" x="20" y="62" as="geometry" />
        </mxCell>
        <mxCell id="avert" parent="1" style="rounded=8;whiteSpace=wrap;html=1;fillColor=#3d1a00;strokeColor=#FF6600;fontSize=13;fontColor=#FF9944;align=center;verticalAlign=middle;fontStyle=1;" value="&lt;b&gt;⚠️ Ces 6 lois ne sont pas des règles de produit. Ce sont les conditions de possibilité de l&#39;institution. Violer l&#39;une d&#39;elles, c&#39;est cesser d&#39;être Micro Rave.&lt;/b&gt;" vertex="1">
          <mxGeometry height="44" width="1614" x="20" y="96" as="geometry" />
        </mxCell>
        <mxCell id="loi1_bg" parent="1" style="rounded=12;whiteSpace=wrap;html=1;fillColor=#1a2a00;strokeColor=#FFD700;strokeWidth=5;" value="" vertex="1">
          <mxGeometry height="220" width="780" x="20" y="158" as="geometry" />
        </mxCell>
        <mxCell id="loi1_num" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontColor=#FFD700;fontStyle=1;" value="① LA LOI ZÉRO" vertex="1">
          <mxGeometry height="32" width="380" x="36" y="166" as="geometry" />
        </mxCell>
        <mxCell id="loi1_badge" parent="1" style="rounded=4;whiteSpace=wrap;html=1;fillColor=#FFD700;strokeColor=none;fontSize=10;fontColor=#000000;fontStyle=1;align=center;" value="SOUVERAINE · TOUTES LES CARTES" vertex="1">
          <mxGeometry height="22" width="340" x="430" y="170" as="geometry" />
        </mxCell>
        <mxCell id="loi1_corps" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#e8e8e8;" value="Une capacité culturelle locale devient un engagement vérifiable,&lt;br&gt;puis un règlement économique, puis une mémoire territoriale.&lt;br&gt;&lt;b&gt;Tout le reste découle de ça.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ce n&#39;est pas une fonctionnalité. C&#39;est la définition de ce qu&#39;est Micro Rave.&lt;br&gt;Si une décision future ne sert pas cette transformation,&lt;br&gt;elle n&#39;appartient pas à cette institution." vertex="1">
          <mxGeometry height="158" width="748" x="36" y="204" as="geometry" />
        </mxCell>
        <mxCell id="loi2_bg" parent="1" style="rounded=12;whiteSpace=wrap;html=1;fillColor=#001a2a;strokeColor=#4488FF;strokeWidth=5;" value="" vertex="1">
          <mxGeometry height="220" width="780" x="854" y="158" as="geometry" />
        </mxCell>
        <mxCell id="loi2_num" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#4488FF;fontStyle=1;" value="② LA CO-DÉPENDANCE PAIEMENT / PRÉSENCE" vertex="1">
          <mxGeometry height="32" width="590" x="870" y="166" as="geometry" />
        </mxCell>
        <mxCell id="loi2_badge" parent="1" style="rounded=4;whiteSpace=wrap;html=1;fillColor=#4488FF;strokeColor=none;fontSize=10;fontColor=#000000;fontStyle=1;align=center;" value="CARTE 02 · CARTE 06" vertex="1">
          <mxGeometry height="22" width="150" x="1464" y="170" as="geometry" />
        </mxCell>
        <mxCell id="loi2_corps" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#e8e8e8;" value="Tu n&#39;es pas payé parce que tu as signé.&lt;br&gt;&lt;b&gt;Tu es payé parce que tu étais là.&lt;/b&gt;&lt;br&gt;&lt;br&gt;La présence est la condition du règlement.&lt;br&gt;Sans preuve de présence, sans argent — jamais silencieux, jamais automatique.&lt;br&gt;&lt;br&gt;C&#39;est le contrat fondamental. Il ne se négocie pas cas par cas." vertex="1">
          <mxGeometry height="158" width="748" x="870" y="204" as="geometry" />
        </mxCell>
        <mxCell id="loi3_bg" parent="1" style="rounded=12;whiteSpace=wrap;html=1;fillColor=#001a0a;strokeColor=#00CC66;strokeWidth=5;" value="" vertex="1">
          <mxGeometry height="220" width="780" x="20" y="396" as="geometry" />
        </mxCell>
        <mxCell id="loi3_num" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontColor=#00CC66;fontStyle=1;" value="③ L&#39;INVARIANT ZÉRO CENT" vertex="1">
          <mxGeometry height="32" width="420" x="36" y="404" as="geometry" />
        </mxCell>
        <mxCell id="loi3_badge" parent="1" style="rounded=4;whiteSpace=wrap;html=1;fillColor=#00CC66;strokeColor=none;fontSize=10;fontColor=#000000;fontStyle=1;align=center;" value="CARTE 03 · LEDGER-02" vertex="1">
          <mxGeometry height="22" width="306" x="464" y="408" as="geometry" />
        </mxCell>
        <mxCell id="loi3_corps" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#e8e8e8;" value="Chaque dollar qui entre doit sortir vers une destination nommée.&lt;br&gt;&lt;b&gt;Les livres tombent à zéro. Toujours.&lt;/b&gt;&lt;br&gt;&lt;br&gt;L&#39;argent ne disparaît pas — il est prouvé.&lt;br&gt;Si les livres ne tombent pas à zéro, l&#39;event ne peut pas être archivé.&lt;br&gt;&lt;br&gt;Ce n&#39;est pas une règle comptable. C&#39;est une promesse institutionnelle." vertex="1">
          <mxGeometry height="158" width="748" x="36" y="442" as="geometry" />
        </mxCell>
        <mxCell id="loi4_bg" parent="1" style="rounded=12;whiteSpace=wrap;html=1;fillColor=#1a001a;strokeColor=#CC44FF;strokeWidth=5;" value="" vertex="1">
          <mxGeometry height="220" width="780" x="854" y="396" as="geometry" />
        </mxCell>
        <mxCell id="loi4_num" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontColor=#CC44FF;fontStyle=1;" value="④ LA DONNÉE-TÉMOIN" vertex="1">
          <mxGeometry height="32" width="380" x="870" y="404" as="geometry" />
        </mxCell>
        <mxCell id="loi4_badge" parent="1" style="rounded=4;whiteSpace=wrap;html=1;fillColor=#CC44FF;strokeColor=none;fontSize=10;fontColor=#000000;fontStyle=1;align=center;" value="CARTE 00 · CARTE 05 · SOTS" vertex="1">
          <mxGeometry height="22" width="356" x="1258" y="408" as="geometry" />
        </mxCell>
        <mxCell id="loi4_corps" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#e8e8e8;" value="Le SOTS ne mesure pas un comportement. &lt;b&gt;Il mémorise une présence vérifiée.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Une donnée-pétrole est extraite à ton insu, raffinée, vendue, disparue.&lt;br&gt;Une donnée-témoin est co-produite avec consentement, conservée pour toujours,&lt;br&gt;contestable par procédure, portée par ceux qui l&#39;ont vécue.&lt;br&gt;&lt;br&gt;La réputation n&#39;est pas un score — c&#39;est une mémoire." vertex="1">
          <mxGeometry height="158" width="748" x="870" y="442" as="geometry" />
        </mxCell>
        <mxCell id="loi5_bg" parent="1" style="rounded=12;whiteSpace=wrap;html=1;fillColor=#1a1000;strokeColor=#FF9900;strokeWidth=5;" value="" vertex="1">
          <mxGeometry height="220" width="780" x="20" y="634" as="geometry" />
        </mxCell>
        <mxCell id="loi5_num" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontColor=#FF9900;fontStyle=1;" value="⑤ LE GREFFIER — PAS LE JUGE" vertex="1">
          <mxGeometry height="32" width="520" x="36" y="642" as="geometry" />
        </mxCell>
        <mxCell id="loi5_badge" parent="1" style="rounded=4;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=none;fontSize=10;fontColor=#000000;fontStyle=1;align=center;" value="CARTE 02 · TOUTES TRANSITIONS" vertex="1">
          <mxGeometry height="22" width="208" x="562" y="646" as="geometry" />
        </mxCell>
        <mxCell id="loi5_corps" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#e8e8e8;" value="Micro Rave automatise seulement ce qui est prouvé.&lt;br&gt;&lt;b&gt;Elle gèle ce qui est incertain. Elle ne prétend pas avoir toujours raison.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Son architecture est son humilité.&lt;br&gt;&lt;br&gt;Un greffier enregistre. Un juge tranche.&lt;br&gt;Micro Rave enregistre les preuves et libère l&#39;argent quand les preuves sont là.&lt;br&gt;Elle ne tranche pas les litiges — elle les documente." vertex="1">
          <mxGeometry height="158" width="748" x="36" y="680" as="geometry" />
        </mxCell>
        <mxCell id="loi6_bg" parent="1" style="rounded=12;whiteSpace=wrap;html=1;fillColor=#1a0000;strokeColor=#FF3344;strokeWidth=5;" value="" vertex="1">
          <mxGeometry height="220" width="780" x="854" y="634" as="geometry" />
        </mxCell>
        <mxCell id="loi6_num" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontColor=#FF3344;fontStyle=1;" value="⑥ L&#39;APPEND-ONLY COMME SACRÉ" vertex="1">
          <mxGeometry height="32" width="520" x="870" y="642" as="geometry" />
        </mxCell>
        <mxCell id="loi6_badge" parent="1" style="rounded=4;whiteSpace=wrap;html=1;fillColor=#FF3344;strokeColor=none;fontSize=10;fontColor=#ffffff;fontStyle=1;align=center;" value="CARTE 02 · WORM · CARTE 05" vertex="1">
          <mxGeometry height="22" width="218" x="1396" y="646" as="geometry" />
        </mxCell>
        <mxCell id="loi6_corps" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#e8e8e8;" value="Ce qui a été écrit reste. &lt;b&gt;Les corrections s&#39;ajoutent — elles ne remplacent pas.&lt;/b&gt;&lt;br&gt;&lt;br&gt;Le passé ne se modifie pas.&lt;br&gt;C&#39;est la différence entre une mémoire et un mensonge.&lt;br&gt;&lt;br&gt;Toucher à un ACCEPTED : erreur.&lt;br&gt;Toucher à un EVENT_SEALED : fraude.&lt;br&gt;Toucher à un ARCHIVED : architecturalement impossible." vertex="1">
          <mxGeometry height="158" width="748" x="870" y="680" as="geometry" />
        </mxCell>
        <mxCell id="trahison" parent="1" style="rounded=8;whiteSpace=wrap;html=1;fillColor=#1a0000;strokeColor=#FF3344;strokeWidth=3;fontSize=16;fontColor=#FF9999;align=center;verticalAlign=middle;fontStyle=1;" value="&lt;b&gt;⚔️ Si une décision future contredit l&#39;une de ces 6 lois, elle n&#39;est pas une évolution de Micro Rave.&lt;br&gt;C&#39;est une trahison de sa fondation.&lt;/b&gt;" vertex="1">
          <mxGeometry height="64" width="1200" x="20" y="872" as="geometry" />
        </mxCell>
        <mxCell id="lois_app" parent="1" style="rounded=8;whiteSpace=wrap;html=1;fillColor=#111111;strokeColor=#555555;fontSize=11;fontColor=#aaaaaa;align=left;verticalAlign=top;" value="&lt;b&gt;Lois de cette carte&lt;/b&gt;&lt;br&gt;LOI-ZERO-01 · CODEP-PRES-01&lt;br&gt;LEDGER-02 · SOTS-TEMOIN-01&lt;br&gt;GREFFIER-01 · WORM-APPEND-01" vertex="1">
          <mxGeometry height="80" width="400" x="1234" y="872" as="geometry" />
        </mxCell>
        <mxCell id="version" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#555555;" value="Micro Rave V4 · Carte 08 · Lois Invariantes · Mai 2026" vertex="1">
          <mxGeometry height="20" width="1614" x="20" y="956" as="geometry" />
        </mxCell>
        <mxCell id="lien_loi1_loi2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#4488FF;" value="→ Carte 02" vertex="1">
          <mxGeometry height="20" width="64" x="790" y="260" as="geometry" />
